Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Global Options:
    Background Color: 45; 45; 45
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Map
      Name: D1 first_map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /qazbot_d1_map/map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: X2 scan RED
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 45; 45
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /qazbot_lio/scan
        Depth: 10
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/TF
      Name: X2 frames
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5
      Frames:
        All Enabled: true
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose and uncertainty
      Enabled: true
      Color: 0; 150; 255
      Shape: Arrow
      Topic:
        Value: /qazbot_d1_map/amcl_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles GREEN
      Enabled: true
      Alpha: 0.6
      Color: 0; 220; 50
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.25
      Topic:
        Value: /qazbot_d1_map/particle_cloud
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /qazbot_d1_map/initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.068538919
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 30
      X: 2.8
      Y: -1.125
  Value: true
Window Geometry:
  Width: 1350
  Height: 900
  X: 50
  Y: 30
