[Unit]
Description=QazBot speech service (kk/ru/en)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/qazbot-speech
ExecStart=%h/qazbot-speech/robot/run.sh --robot
Environment=QAZBOT_ENV=%h/.config/qazbot_speech/env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
