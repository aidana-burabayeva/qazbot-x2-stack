+void Preprocess::aima_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+
+  pcl::PointCloud<aima_ros::Point> pl_orig;
+  pcl::fromROSMsg(*msg, pl_orig);
+  const int plsize = pl_orig.points.size();
+  if (plsize == 0)
+    return;
+  pl_surf.reserve(plsize / std::max(point_filter_num, 1) + 1);
+
+  given_offset_time = true;
+  for (int i = 0; i < plsize; i++)
+  {
+    if (i % point_filter_num != 0)
+      continue;
+    const auto &p = pl_orig.points[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z))
+      continue;
+    const double range = p.x * p.x + p.y * p.y + p.z * p.z;
+    if (range < (blind * blind))
+      continue;
+
+    PointType added_pt;
+    added_pt.x = p.x;
+    added_pt.y = p.y;
+    added_pt.z = p.z;
+    added_pt.intensity = p.intensity;
+    added_pt.normal_x = 0;
+    added_pt.normal_y = 0;
+    added_pt.normal_z = 0;
+    added_pt.curvature = p.timestamp * time_unit_scale;  // curvature unit: ms
+    pl_surf.points.push_back(added_pt);
+  }
+  // sync_packages takes the scan end from the LAST point, and this driver
+  // does not deliver the points in time order.
+  std::stable_sort(pl_surf.points.begin(), pl_surf.points.end(),
+                   [](const PointType &a, const PointType &b) { return a.curvature < b.curvature; });
+  pl_surf.width = pl_surf.points.size();
+  pl_surf.height = 1;
+}
