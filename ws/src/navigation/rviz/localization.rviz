Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Global Options:
    Background Color: 45; 45; 45
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Map
      Name: D1 first_map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /qazbot_d1_map/map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: X2 scan RED
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 45; 45
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /qazbot_lio/scan
        Depth: 10
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/TF
      Name: X2 frames
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5
      Frames:
        All Enabled: true
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose and uncertainty
      Enabled: true
      Color: 0; 150; 255
      Shape: Arrow
      Topic:
        Value: /qazbot_d1_map/amcl_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles GREEN
      Enabled: true
      Alpha: 0.6
      Color: 0; 220; 50
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.25
      Topic:
        Value: /qazbot_d1_map/particle_cloud
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 global plan (planner)
      Enabled: true
      Color: 255; 200; 0
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /qazbot_d1_map/nav2/plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Path
      Name: RPP local plan (received_global_plan)
      Enabled: true
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /qazbot_d1_map/nav2/received_global_plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: RPP lookahead point
      Enabled: true
      Color: 255; 0; 255
      Radius: 0.08
      History Length: 1
      Topic:
        Value: /qazbot_d1_map/nav2/lookahead_point
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint (local costmap)
      Enabled: true
      Color: 255; 255; 255
      Alpha: 1
      Topic:
        Value: /qazbot_d1_map/nav2/local_costmap/published_footprint
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Goal (coordinator goal_pose)
      Enabled: true
      Color: 255; 120; 0
      Shape: Arrow
      Topic:
        Value: /qazbot_d1_map/goal_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /qazbot_d1_map/nav2/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /qazbot_d1_map/nav2/global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: scan_obstacles (costmap marking)
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /qazbot_lio/scan_obstacles
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: scan_clearing (costmap clearing)
      Enabled: false
      Alpha: 0.5
      Color Transformer: FlatColor
      Color: 0; 170; 255
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Decay Time: 0
      Topic:
        Value: /qazbot_lio/scan_clearing
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /qazbot_d1_map/initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.068538919
    # Dry-run goal: the goal coordinator (ns /qazbot_d1_map) subscribes goal_pose and forwards it to the single
    # bt_navigator through its NavigateToPose gate. Do not use /qazbot_d1_map/nav2/goal_pose (bypasses the gate).
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /qazbot_d1_map/goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 30
      X: 2.8
      Y: -1.125
  Value: true
Window Geometry:
  Width: 1350
  Height: 900
  X: 50
  Y: 30
