[Unit]
Description=QazBot nightly orchestrator (simulation only, SQLite queue)

[Service]
Type=simple
WorkingDirectory=/home/adn/QazBot/control_backend_p20_twin02
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/adn/.local/bin
Environment=QAZBOT_LAB=1 TWIN_ENVFILE=.env.lab NIGHTLY_ROBOT_REF=origin/robot/stable
ExecStart=/usr/bin/python3 tools/nightly/nq.py daemon --keep-alive
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=default.target
