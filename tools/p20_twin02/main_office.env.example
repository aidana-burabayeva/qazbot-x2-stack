# Copy to .env. Everything has a safe default; edit only what you need.
TWIN_VERSION=dev
TWIN_UID=1000
TWIN_GID=1000
# Production limit of the in-place turn rate (rad/s). Held at 0.5 until the operator approves a change.
MAX_ANGULAR=0.5
# Resources
SIM_CPUS=4
SIM_MEM=8g
STACK_CPUS=4
STACK_MEM=6g
# 1 = show the MuJoCo window on the host display (needs `xhost +local:` once); 0 = headless (Xvfb)
TWIN_GUI=0
# Result directory name of `make scenario`
RUN_NAME=run01
# World: `map` = physical walls generated from the navigation map (default), `flat` = vendor's empty floor
TWIN_WORLD=map
# Map directory name under control_backend/ws/src/maps and the robot's start pose in it (x,y,yaw). Both containers use them.
TWIN_MAP=main_office
TWIN_START=-1.275,-4.825,0.0

TWIN_BACKEND=../../control_backend

# Shared map in control_backend; path relative to docker/.
TWIN_MAP_DIR=../../control_backend/ws/src/maps/main_office
