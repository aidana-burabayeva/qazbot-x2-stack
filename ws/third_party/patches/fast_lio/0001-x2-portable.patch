+# AgiBot X2: chest LiDAR (96 rings, ~103 deg wedge, 10 Hz, per-point
+# timestamp in ns) + torso IMU (~390 Hz, BEST_EFFORT).
+# Memory: everything that accumulates without a bound is OFF here --
+# path (grows every 10 frames), map_en (pcl_wait_pub keeps every scan),
+# pcd_save. The ikd-tree lives in a cube of cube_side_length around the
+# robot and points outside it are deleted; a new point enters the tree only
+# if its voxel is empty, so a standing robot adds nothing.
+/**:
+    ros__parameters:
+        feature_extract_enable: false
+        point_filter_num: 2
+        max_iteration: 3
+        filter_size_surf: 0.2
+        filter_size_map: 0.2
+        cube_side_length: 100.0
+        runtime_pos_log_enable: false
+        map_file_path: ""
+
+        common:
+            lid_topic:  "/aima/hal/sensor/lidar_chest_front/lidar_pointcloud"
+            imu_topic:  "/aima/hal/imu/torso/state"
+            time_sync_en: false
+            time_offset_lidar_to_imu: 0.0
+
+        preprocess:
+            lidar_type: 5                # AIMA (x2 patch)
+            scan_line: 96
+            scan_rate: 10
+            timestamp_unit: 3            # ns
+            blind: 0.5
+
+        mapping:
+            acc_cov: 0.1
+            gyr_cov: 0.1
+            b_acc_cov: 0.0001
+            b_gyr_cov: 0.0001
+            fov_degree:    110.0
+            det_range:     30.0
+            extrinsic_est_en:  false
+            # lidar_chest_front in imu_in_torso_link, from /tf_static:
+            # torso->imu t(-0.0249, 0.002, 0.1059) R=I,
+            # torso->lidar t(0.1026, 0, 0.1816) R=Rx(-90 deg)
+            extrinsic_T: [ 0.1275, -0.0020, 0.0757 ]
+            extrinsic_R: [ 1., 0., 0.,
+                           0., 0., 1.,
+                           0., -1., 0. ]
+
+        publish:
+            path_en:  false
+            map_en: false
+            effect_map_en: false
+            scan_publish_en:  true
+            dense_publish_en: false
+            scan_bodyframe_pub_en: false
+
+        pcd_save:
+            pcd_save_en: false
+            interval: -1
