import unittest
from test_loc_trust import L, make_inputs, room_grid, simulate_scan
from source_stamp import SourceStamp

class SourceFailures(unittest.TestCase):
    def setUp(self):
        self.g=room_grid();self.pose=(0.,0.,0.);self.scan=simulate_scan(self.g,self.pose)
        self.ev=L.TrustEvaluator(self.g,L.TrustConfig(stable_s=0))
        self.ev.set_baseline([L.soft_score(self.scan,self.g,self.pose,.05)])
        self.ev.confirm_anchor(make_inputs(1,self.pose,self.pose,self.scan))
    def test_odom_loss_blocks_even_when_everything_else_is_fresh(self):
        r=self.ev.evaluate(make_inputs(10,self.pose,self.pose,self.scan,odom_stamp=1))
        self.assertFalse(r['trusted']);self.assertIn('T1_odom_stale',r['reasons'])
    def test_odom_topic_loss_blocks_even_with_fresh_tf(self):
        r=self.ev.evaluate(make_inputs(10,self.pose,self.pose,self.scan,odom_msg_stamp=1))
        self.assertFalse(r['trusted']);self.assertIn('T1_odom_message_stale',r['reasons'])
    def test_missing_calibration_blocks(self):
        self.ev.baseline=None
        self.assertIn('T4_no_baseline',self.ev.evaluate(make_inputs(2,self.pose,self.pose,self.scan))['reasons'])
    def test_ambiguous_scene_has_no_automatic_travel_budget(self):
        self.ev.degenerate_since_len=0
        r=self.ev.evaluate(make_inputs(2,self.pose,self.pose,self.scan))
        self.assertFalse(r['trusted']);self.assertIn('T7_ambiguous',r['reasons'])
    def test_no_unmeasured_tolerance_growth(self):
        c=L.TrustConfig();self.assertEqual(c.anchor_xy_per_m,0);self.assertEqual(c.anchor_yaw_per_rad,0)
    def test_source_replay_cannot_refresh_age(self):
        s=SourceStamp();self.assertEqual(s.accept(10,10,100),100)
        self.assertEqual(s.accept(10,11,101),float('-inf'))
        self.assertEqual(s.accept(9,11,101),float('-inf'))
        self.assertEqual(s.accept(11,11,101),101)
    def test_delayed_source_preserves_age(self):
        self.assertEqual(SourceStamp().accept(10,12,100),98)
    def test_future_and_zero_source_invalid(self):
        s=SourceStamp();self.assertEqual(s.accept(12,10,100),float('-inf'))
        self.assertEqual(s.accept(0,10,100),float('-inf'))
    def test_empty_scan_cannot_be_trusted(self):
        import numpy as np
        r=self.ev.evaluate(make_inputs(2,self.pose,self.pose,np.empty((0,2))))
        self.assertIn('T4_empty_scan',r['reasons']);self.assertFalse(r['trusted'])
    def test_nonfinite_pose_cannot_be_trusted(self):
        r=self.ev.evaluate(make_inputs(2,(float('nan'),0,0),self.pose,self.scan))
        self.assertFalse(r['trusted']);self.assertIn('T0_invalid_pose',r['reasons'])
    def test_invalid_pose_does_not_poison_recovery_history(self):
        import math
        self.ev.evaluate(make_inputs(2,self.pose,(float('nan'),0,0),self.scan))
        r=self.ev.evaluate(make_inputs(3,self.pose,self.pose,self.scan))
        self.assertTrue(math.isfinite(self.ev.path_len));self.assertTrue(r['trusted'],r)
    def test_negative_covariance_cannot_be_trusted(self):
        from test_loc_trust import COV
        c=COV.copy();c[0]=-1
        r=self.ev.evaluate(make_inputs(2,self.pose,self.pose,self.scan,amcl_cov=c))
        self.assertFalse(r['trusted']);self.assertIn('T2_covariance',r['reasons'])
    def test_amcl_postdated_tf_uses_explicit_contract(self):
        self.assertEqual(SourceStamp().accept(11,10,100,max_future_s=1),100)

if __name__=='__main__':unittest.main()
