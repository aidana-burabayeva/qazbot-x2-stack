# Copy to .env. Everything has a safe default; edit only what you need.
TWIN_UID=1000
TWIN_GID=1000
# Production limit of the in-place turn rate (rad/s). Held at 0.5 until the operator approves a change.
MAX_ANGULAR=0.5
# Resources
SIM_CPUS=4
SIM_MEM=8g
STACK_CPUS=4
STACK_MEM=6g
# 1 = show the MuJoCo window on the host display (needs `xhost +local:` once); 0 = headless (Xvfb)
TWIN_GUI=0
# Result directory name of `make scenario`
RUN_NAME=run01
# World: `map` = physical walls generated from the navigation map (default), `flat` = vendor's empty floor
TWIN_WORLD=map
# Lab profile (QAZBOT_LAB): the map and start pose of the INSTALLED X2 (scripts/contract/robot.env). Start pose = first operator initialpose of the 2026-10-30 hardware series (initialpose_episodes.json).

# Path of the navigation stack repo relative to docker/ (default ../.. = repo root). `make` sets it itself; set it here only for scripts run without make.
# TWIN_BACKEND=../../control_backend

# Optional external map directory (map.yaml, map.pgm, manifest.json), relative to docker/.
# TWIN_MAP_DIR=../../t2/nav2
TWIN_VERSION=nightly
TWIN_MAP=d1_qazbot_20261029
TWIN_START=-8.344,-1.213,-2.145
# Goal checker as run on the X2 (actual_parameters.json: xy_goal_tolerance 0.35, yaw_goal_tolerance 0.17); cross-checked by tests/nightly/test_contract.py
TWIN_XY_TOL=0.35
TWIN_YAW_TOL=0.17
# vendor tree (gitignored, 2.5 GB, sha256 manifest identical to the tracked vendor/manifest.sha256) lives in the operator checkout
TWIN_VENDOR=/home/adn/QazBot/digital_twin/vendor
