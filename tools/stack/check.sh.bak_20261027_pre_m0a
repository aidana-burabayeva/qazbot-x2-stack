#!/usr/bin/env bash
# One-shot read-only health check of the dry-run stack (subscribe/graph only; no publishing, no goals).
# Uses the stack DDS profile dds_qazbot.xml (via env.sh) and hard timeouts. Usage: tools/stack/check.sh [SECONDS]
D="${1:-20}"
H=/home/agi/control_backend/tools/stack
source /home/agi/control_backend/ws/src/navigation/env.sh >/dev/null 2>&1
set +e
echo "FASTRTPS_DEFAULT_PROFILES_FILE=$FASTRTPS_DEFAULT_PROFILES_FILE"
echo "== graph / lifecycle / adapter + coordinator status"
timeout 60 python3 "$H/graph_probe.py" 2>/dev/null
echo "== rates, stamp age = CLOCK_REALTIME - header.stamp (s), trust reasons over ${D}s"
timeout $((D + 30)) python3 "$H/age_probe.py" "$D" /qazbot_lio/odometry:odom /qazbot_lio/odom_level:odom /qazbot_lio/scan:scan \
  /qazbot_d1_map/tf:tf:rel /qazbot_d1_map/localization_trust/status:str:rel 2>/dev/null
