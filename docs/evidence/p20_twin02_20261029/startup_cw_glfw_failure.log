configurator:
  temp_cfg_path: ./cfg/tmp
plugin:
  plugins:
    - name: sm_plugin
      path: /opt/sim/lib/libaimrt_sm_plugin.so
      options: ~
    - name: net_plugin
      path: /opt/sim/lib/libaimrt_net_plugin.so
      options:
        thread_num: 4
        http_options:
          listen_ip: 0.0.0.0
          listen_port: 51822
    - name: ros2_plugin
      path: /opt/sim/lib/libaimrt_ros2_plugin.so
      options:
        node_name: aimrt_sim_node
        executor_type: MultiThreaded
        executor_name: ros2_executor
        executor_sched_policy: ""
        executor_bind_cpus:
          []
        executor_thread_num: 4
        auto_initialize_logging: false
    - name: nsm_plugin
      path: /opt/sim/lib/libaimrt_nsm_plugin.so
      options:
        node_name: soc_sim
        state_reporting_executor: nsm_state_reporting_executor
        state_reporting_period:
          value: 1
          unit: sec
        modules_processing_executor: nsm_modules_processing_executor
    - name: monitor_plugin
      path: /opt/sim/lib/libaimrt_monitor_plugin.so
      options:
        executor: monitor_thread
        node_name: soc_sim
