Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: D1 map
      Enabled: true
      Alpha: 0.9
      Color Scheme: map
      Topic:
        Value: /qazbot_d1_map/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.25
      Color Scheme: costmap
      Topic:
        Value: /qazbot_d1_map/nav2/global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /qazbot_d1_map/nav2/local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (what AMCL and Nav2 see)
      Enabled: true
      Topic:
        Value: /qazbot_lio/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.04
      Style: Points
      Color: 255; 80; 80
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Topic:
        Value: /qazbot_d1_map/nav2/plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.05
      Color: 255; 220; 40
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Topic:
        Value: /qazbot_d1_map/particle_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow (Flat)
      Color: 0; 200; 255
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /qazbot_d1_map/nav2/local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 40; 255; 40
    - Class: rviz_default_plugins/Odometry
      Name: GROUND TRUTH (MuJoCo plant, not used by localization)
      Enabled: true
      Topic:
        Value: /x2_twin/model_truth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 1
      Shape:
        Value: Arrow
        Color: 80; 120; 255
    - Class: rviz_default_plugins/Marker
      Name: Operator panel (Trust / seed fit / goal)
      Enabled: true
      Topic:
        Value: /qazbot_d1_map/operator/panel
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /qazbot_d1_map/initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /qazbot_d1_map/goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: map
      Scale: 28
      Angle: 0
      X: -8.3
      Y: -1.2
Window Geometry:
  Width: 1500
  Height: 980
