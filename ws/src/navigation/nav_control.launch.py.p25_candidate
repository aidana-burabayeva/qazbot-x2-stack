"""[P25 CANDIDATE: controller:=rpp|mppi, obstacle_layer:=i1|stvl; defaults = pre-P25 behaviour]
Nav2 controller_server (RPP) + velocity_smoother for X2, command path only up to a PRIVATE topic.

Output chain: controller_server -> <ns>/cmd_vel_nav -> velocity_smoother -> <ns>/cmd_vel.
Nothing here talks to MC and nothing publishes the global /cmd_vel; x2_motion_adapter (dry_run by default)
is the only reader of <ns>/cmd_vel. Limits below are CANDIDATES for dry tests (docs/X2_NAV2_CONTROLLER.md),
not approved walking limits. Lateral speed is zero by design (MC lateral start threshold 0.5-0.7 m/s).
Processes start 0.6 s apart (AimDK: at most 2 new ROS nodes per second while the robot stands or walks).
"""
import os
import sys
import tempfile

import yaml
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, OpaqueFunction
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node
from launch_ros.descriptions import ParameterFile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from launch_stagger import staggered  # noqa: E402


# P18 2026-10-29: real X2 body polygon about base_footprint (nav point = chest LIDAR IMU projection).
# Source: vendor 12-pt footprint /agibot/software/nav/config/vectorflux_common/a2/app2.yaml (base_link,
# +-0.20 x +-0.225 / +-0.075 x +-0.336, chamfered) shifted by base_link->base_footprint (+0.0866,+0.0161)
# (qazbot-x2-stack/docs/X2_FOOTPRINT.md), +2 cm on sides/back, front +0.17 (rest-measured +0.119 plus
# ~5 cm unmeasured walking arm swing). costmap footprint_padding adds 0.01 on top.
# Circumscribed ~0.43 m (< old circle 0.464): in-place rotation is checked on this rotating polygon by RPP.
X2_FOOTPRINT = [(0.17, 0.229), (0.008, 0.34), (-0.182, 0.34), (-0.305, 0.229),
                (-0.305, -0.261), (-0.182, -0.372), (0.008, -0.372), (0.17, -0.261)]
X2_FOOTPRINT_STR = '[' + ', '.join(f'[{x}, {y}]' for x, y in X2_FOOTPRINT) + ']'

# P25 2026-10-30 (CANDIDATE): switches controller:=rpp|mppi, obstacle_layer:=i1|stvl.
# Defaults rpp/i1 produce exactly the pre-P25 parameters and process environment.
# MPPI (nav2_mppi_controller 1.1.18 deb, same ROS snapshot 2025-08-15 as runtime/qazbot_nav_deps) and openvdb_vendor
# are unpacked into runtime/nav_ext_ws/root; STVL 2.3.4 is built from source into runtime/nav_ext_ws/install
# (its deb typesupport needs libfastcdr.so.1; the vendor ROS here has Fast-CDR 2). The overlay is added
# ONLY to the environment of the Nav2 processes that need it (never to the shell / other nodes).
CONTROLLERS = ('rpp', 'mppi')
OBSTACLE_LAYERS = ('i1', 'stvl')


def nav_ext_prefixes():
    """[colcon install (STVL built from source against the vendor ROS / Fast-CDR 2), binary root (MPPI, openvdb)]."""
    backend = os.environ.get('QAZBOT_BACKEND') or os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..'))
    ws = os.environ.get('QAZBOT_NAV_EXT_WS') or os.path.join(backend, 'runtime', 'nav_ext_ws')
    return [os.path.realpath(os.path.join(ws, 'install')), os.path.realpath(os.path.join(ws, 'root', 'opt', 'ros', 'humble'))]


def nav_ext_env(packages):
    """additional_env for a Node that loads MPPI/STVL plugins; fails at launch time if the overlay is incomplete."""
    prefixes = nav_ext_prefixes()
    for p in packages:
        if not any(os.path.isfile(os.path.join(x, 'share', 'ament_index', 'resource_index', 'packages', p)) for x in prefixes):
            raise RuntimeError(f'P25 overlay {prefixes} lacks {p}; see runtime/nav_ext_ws/README_P25.txt')
    libs = [os.path.join(x, 'lib') for x in prefixes] + [os.path.join(prefixes[1], 'opt', 'openvdb_vendor', 'lib')]
    return {'AMENT_PREFIX_PATH': ':'.join(prefixes + [os.environ.get('AMENT_PREFIX_PATH', '')]),
            'LD_LIBRARY_PATH': ':'.join(libs + [os.environ.get('LD_LIBRARY_PATH', '')])}


def stvl_layer_params(name, topic):
    """STVL replacement for the I1 ObstacleLayer (marking scan_obstacles + bounded scan_clearing).

    Input: <scan>_obstacles = flattened nearest-return cloud in base_footprint (z=0, slice 0.35-1.8 m above
    the floor, FOV ~-46..+44.5 deg, range 0.45..). Marking is limited to 3.0 m like I1. Clearing is a
    3D-lidar frustum (model_type 1) at the cloud frame origin (base_footprint, same plane as the marks),
    +-44 deg x 0.45..3.5 m: voxels inside it that are NOT re-marked decay with acceleration (ghost of a
    person who left the FOV is gone in ~1.4 s); voxels outside the FOV decay linearly within voxel_decay 8 s.
    Re-marked real obstacles (5 Hz scan) never reach the decay threshold.
    """
    p = f'{name}.'
    return {
        p + 'plugin': 'spatio_temporal_voxel_layer/SpatioTemporalVoxelLayer',
        p + 'enabled': True, p + 'voxel_decay': 8.0, p + 'decay_model': 0, p + 'voxel_size': 0.05,
        p + 'track_unknown_space': False, p + 'mark_threshold': 0, p + 'update_footprint_enabled': True,
        p + 'combination_method': 1, p + 'origin_z': 0.0, p + 'publish_voxel_map': False,
        p + 'transform_tolerance': 0.2, p + 'mapping_mode': False, p + 'map_save_duration': 60.0,
        p + 'observation_sources': 'scan_mark scan_clear',
        p + 'scan_mark.data_type': 'PointCloud2', p + 'scan_mark.topic': topic,
        p + 'scan_mark.marking': True, p + 'scan_mark.clearing': False,
        p + 'scan_mark.obstacle_range': 3.0,
        # marks are flattened to z=0 in base_footprint; odom/map are planar -> wide band, no height filtering
        p + 'scan_mark.min_obstacle_height': -0.5, p + 'scan_mark.max_obstacle_height': 0.5,
        p + 'scan_mark.expected_update_rate': 0.0, p + 'scan_mark.observation_persistence': 0.0,
        p + 'scan_mark.inf_is_valid': False, p + 'scan_mark.filter': 'passthrough',
        p + 'scan_mark.voxel_min_points': 0, p + 'scan_mark.clear_after_reading': True,
        p + 'scan_clear.data_type': 'PointCloud2', p + 'scan_clear.topic': topic,
        p + 'scan_clear.marking': False, p + 'scan_clear.clearing': True,
        p + 'scan_clear.model_type': 1,                 # 3D-lidar frustum: hFOV about +x, vFOV symmetric about z=0
        p + 'scan_clear.min_z': 0.45, p + 'scan_clear.max_z': 3.5,   # radial near/far of the frustum, m
        p + 'scan_clear.horizontal_fov_angle': 1.54,    # rad, ~+-44 deg (finite returns -46..+44.5 deg)
        p + 'scan_clear.vertical_fov_angle': 0.2,       # rad; marks lie in the z=0 plane of the frustum
        p + 'scan_clear.vertical_fov_padding': 0.1,     # m
        # in-FOV unconfirmed voxel cleared when 8 - t - a*t^3/6 < 0  -> a=15: t~1.4 s
        p + 'scan_clear.decay_acceleration': 15.0,
        p + 'scan_clear.expected_update_rate': 0.0, p + 'scan_clear.observation_persistence': 0.0,
        p + 'scan_clear.clear_after_reading': True,
    }


def i1_layer_params(name, scan):
    """Pre-P25 ObstacleLayer (I1): marking <scan>_obstacles, bounded clearing rays <scan>_clearing."""
    p = f'{name}.'
    return {p + 'plugin': 'nav2_costmap_2d::ObstacleLayer',
            p + 'observation_sources': 'scan bounded_rays',
            p + 'scan.topic': scan + '_obstacles', p + 'scan.data_type': 'PointCloud2',
            p + 'scan.marking': True, p + 'scan.clearing': False,
            p + 'scan.inf_is_valid': False,
            p + 'scan.obstacle_max_range': 3.0, p + 'scan.raytrace_max_range': 3.5,
            p + 'bounded_rays.topic': scan + '_clearing',
            p + 'bounded_rays.data_type': 'PointCloud2',
            p + 'bounded_rays.marking': False, p + 'bounded_rays.clearing': True,
            p + 'bounded_rays.raytrace_max_range': 3.5}


def mppi_params(vmax, wmax, hz, batch, inflation_radius, cost_scaling_factor):
    """nav2_mppi_controller 1.1.18 (Humble, xtensor). DiffDrive, forward only, no Twirling.

    Horizon 2.0 s; model_dt = 1/controller_frequency (MPPI shifts its control sequence by one model_dt per
    cycle). wz is limited to +-wmax (0.6); MPPI can still output |wz| inside the MC deadband (0.3-0.4):
    the adapter yaw-rate loop owns that (VelocityDeadbandCritic is NOT used: it would also penalise wz=0).
    """
    dt = 1.0 / hz
    f = 'FollowPath.'
    c = {
        f + 'plugin': 'nav2_mppi_controller::MPPIController',
        f + 'motion_model': 'DiffDrive', f + 'time_steps': int(round(2.0 / dt)), f + 'model_dt': dt,
        f + 'batch_size': batch, f + 'iteration_count': 1, f + 'temperature': 0.3, f + 'gamma': 0.015,
        f + 'vx_max': vmax, f + 'vx_min': 0.0, f + 'vy_max': 0.0, f + 'wz_max': wmax,
        f + 'vx_std': 0.1, f + 'vy_std': 0.0, f + 'wz_std': 0.3,
        f + 'prune_distance': 1.2, f + 'transform_tolerance': 0.2, f + 'reset_period': 1.0,
        f + 'retry_attempt_limit': 1, f + 'regenerate_noises': False, f + 'enforce_path_inversion': False,
        f + 'visualize': False,
        f + 'critics': ['ConstraintCritic', 'ObstaclesCritic', 'GoalCritic', 'GoalAngleCritic',
                        'PathAlignCritic', 'PathFollowCritic', 'PathAngleCritic', 'PreferForwardCritic'],
        f + 'ConstraintCritic.enabled': True, f + 'ConstraintCritic.cost_power': 1,
        f + 'ConstraintCritic.cost_weight': 4.0,
        f + 'ObstaclesCritic.enabled': True, f + 'ObstaclesCritic.cost_power': 1,
        f + 'ObstaclesCritic.repulsion_weight': 1.5, f + 'ObstaclesCritic.critical_weight': 20.0,
        f + 'ObstaclesCritic.consider_footprint': True,   # X2 polygon from the local costmap
        f + 'ObstaclesCritic.collision_cost': 10000.0, f + 'ObstaclesCritic.collision_margin_distance': 0.10,
        f + 'ObstaclesCritic.near_goal_distance': 0.5, f + 'ObstaclesCritic.inflation_layer_name': 'inflation_layer',
        f + 'ObstaclesCritic.inflation_radius': inflation_radius,
        f + 'ObstaclesCritic.cost_scaling_factor': cost_scaling_factor,
        f + 'GoalCritic.enabled': True, f + 'GoalCritic.cost_power': 1, f + 'GoalCritic.cost_weight': 5.0,
        f + 'GoalCritic.threshold_to_consider': 1.0,
        f + 'GoalAngleCritic.enabled': True, f + 'GoalAngleCritic.cost_power': 1,
        f + 'GoalAngleCritic.cost_weight': 3.0, f + 'GoalAngleCritic.threshold_to_consider': 0.5,
        f + 'PathAlignCritic.enabled': True, f + 'PathAlignCritic.cost_power': 1,
        f + 'PathAlignCritic.cost_weight': 14.0, f + 'PathAlignCritic.max_path_occupancy_ratio': 0.05,
        f + 'PathAlignCritic.trajectory_point_step': 3, f + 'PathAlignCritic.threshold_to_consider': 0.5,
        f + 'PathAlignCritic.offset_from_furthest': 20, f + 'PathAlignCritic.use_path_orientations': False,
        f + 'PathFollowCritic.enabled': True, f + 'PathFollowCritic.cost_power': 1,
        f + 'PathFollowCritic.cost_weight': 5.0, f + 'PathFollowCritic.offset_from_furthest': 5,
        f + 'PathFollowCritic.threshold_to_consider': 1.0,
        f + 'PathAngleCritic.enabled': True, f + 'PathAngleCritic.cost_power': 1,
        f + 'PathAngleCritic.cost_weight': 2.0, f + 'PathAngleCritic.offset_from_furthest': 4,
        f + 'PathAngleCritic.threshold_to_consider': 0.5, f + 'PathAngleCritic.max_angle_to_furthest': 1.0,
        f + 'PathAngleCritic.forward_preference': True,
        f + 'PreferForwardCritic.enabled': True, f + 'PreferForwardCritic.cost_power': 1,
        f + 'PreferForwardCritic.cost_weight': 15.0,   # strong: no reverse (vx_min=0 already forbids it)
        f + 'PreferForwardCritic.threshold_to_consider': 0.5,
    }
    return c


def setup(context, raw=False):
    L = lambda n: LaunchConfiguration(n).perform(context)
    ns = L('ns')
    radius = float(L('robot_radius'))
    if not radius > 0:
        raise ValueError('robot_radius must be the positive body envelope; no default')
    vmax, wmax = float(L('max_linear')), float(L('max_angular'))
    goal_stateful=context.launch_configurations.get('goal_checker_stateful','false').lower()
    if goal_stateful not in ('true','false'):
        raise ValueError('goal_checker_stateful must be true or false')
    controller = L('controller')
    obstacle_layer = L('obstacle_layer')
    if controller not in CONTROLLERS:
        raise ValueError(f'controller must be one of {CONTROLLERS}')
    if obstacle_layer not in OBSTACLE_LAYERS:
        raise ValueError(f'obstacle_layer must be one of {OBSTACLE_LAYERS}')
    mppi_hz, mppi_batch = float(L('mppi_hz')), int(L('mppi_batch'))
    if not 5.0 <= mppi_hz <= 30.0 or not 200 <= mppi_batch <= 4000:
        raise ValueError('mppi_hz must be 5..30, mppi_batch 200..4000')
    experimental_turn = os.environ.get('QAZBOT_SIM_MC_TURN') == '1'
    experimental_walk = os.environ.get('QAZBOT_SIM_MC_WALK') == '1'
    linear_decel = os.environ.get('QAZBOT_SIM_MC_LINEAR_DECEL')
    if linear_decel is not None and not experimental_turn:
        raise RuntimeError('SIM linear braking experiment requires isolated MC controller')
    if experimental_walk and not experimental_turn:
        raise RuntimeError('MC walk candidate requires isolated MC turn controller')
    pose_refine = os.environ.get('QAZBOT_SIM_POSE_REFINE') == '1'
    if pose_refine:
        if experimental_turn or any(os.environ.get(k)!=v for k,v in {'QAZBOT_SIM':'1','ROS_DOMAIN_ID':'87','ROS_LOCALHOST_ONLY':'1'}.items()):
            raise RuntimeError('Pose refinement requires isolated simulation without the MC turn experiment')
    if experimental_turn:
        if any(os.environ.get(k) != v for k,v in {'QAZBOT_SIM':'1','ROS_DOMAIN_ID':'87','ROS_LOCALHOST_ONLY':'1'}.items()):
            raise RuntimeError('MC turn candidate is restricted to the isolated SIM')
        wmax = 0.8
    if controller == 'mppi' and (experimental_turn or pose_refine):
        raise RuntimeError('controller:=mppi cannot be combined with the SIM MC-turn / pose-refine controllers')
    controller_hz = 20.0 if controller == 'rpp' else mppi_hz
    # RPP clamps rotation relative to MEASURED yaw rate each cycle. At rest,
    # 1 rad/s^2 / 20 Hz = 0.05 rad/s never starts the X2 turn (G3/G4 bags).
    # Let RPP request its existing angular cap in one cycle; the mandatory
    # OPEN_LOOP smoother below still limits the command ramp to 1 rad/s^2.
    rpp_angular_accel = wmax * controller_hz
    scan = L('scan_topic')
    odom = L('odom_topic')
    obstacle_name = 'stvl_layer' if obstacle_layer == 'stvl' else 'obstacle_layer'
    local_plugins = ([obstacle_name] if scan else []) + ['inflation_layer']
    local_inflation = (0.50, 3.0)   # radius, cost_scaling_factor (operator 2026-10-29)
    local = {
        'use_sim_time': False, 'update_frequency': 5.0, 'publish_frequency': 2.0,
        'global_frame': context.launch_configurations.get('local_frame','odom'), 'robot_base_frame': 'base_footprint',
        'rolling_window': True, 'width': 4, 'height': 4, 'resolution': 0.05,
        # P18: real polygon instead of circle robot_radius (circle 0.464 hit lethal at 0.47 m at every yaw)
        'footprint': X2_FOOTPRINT_STR, 'footprint_padding': 0.01, 'plugins': local_plugins,
        'inflation_layer.plugin': 'nav2_costmap_2d::InflationLayer',
        'inflation_layer.inflation_radius': local_inflation[0], 'inflation_layer.cost_scaling_factor': local_inflation[1],  # inflation_radius 0.50: operator 2026-10-29
    }
    if scan:
        local.update(stvl_layer_params(obstacle_name, scan + '_obstacles') if obstacle_layer == 'stvl'
                     else i1_layer_params(obstacle_name, scan))
    params = {
        f'/{ns}/controller_server': {'ros__parameters': {
            'use_sim_time': False, 'controller_frequency': controller_hz, 'min_x_velocity_threshold': 0.001,
            'min_y_velocity_threshold': 0.0, 'min_theta_velocity_threshold': 0.001, 'failure_tolerance': 10.0,
            'progress_checker_plugin': 'progress_checker', 'goal_checker_plugins': ['goal_checker'],
            'controller_plugins': ['FollowPath'], 'odom_topic': odom,
            'progress_checker.plugin': 'nav2_controller::PoseProgressChecker',
            'progress_checker.required_movement_radius': 0.1, 'progress_checker.movement_time_allowance': 15.0,
            'progress_checker.required_movement_angle': 0.25,
            'goal_checker.plugin': 'nav2_controller::SimpleGoalChecker',
            'goal_checker.xy_goal_tolerance': float(L('xy_tol')), 'goal_checker.yaw_goal_tolerance': float(L('yaw_tol')),
            'goal_checker.stateful': goal_stateful == 'true',
            'FollowPath.plugin': 'nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController',
            'FollowPath.desired_linear_vel': vmax, 'FollowPath.lookahead_dist': 0.5,
            'FollowPath.min_lookahead_dist': 0.3, 'FollowPath.max_lookahead_dist': 0.9,
            'FollowPath.lookahead_time': 1.5, 'FollowPath.use_velocity_scaled_lookahead_dist': False,
            'FollowPath.transform_tolerance': 0.2, 'FollowPath.allow_reversing': False,
            'FollowPath.use_rotate_to_heading': True, 'FollowPath.rotate_to_heading_angular_vel': wmax,
            'FollowPath.rotate_to_heading_min_angle': 0.6, 'FollowPath.max_angular_accel': rpp_angular_accel,
            'FollowPath.use_regulated_linear_velocity_scaling': True,
            'FollowPath.regulated_linear_scaling_min_radius': 0.9,
            'FollowPath.regulated_linear_scaling_min_speed': 0.15,
            'FollowPath.use_cost_regulated_linear_velocity_scaling': False,
            'FollowPath.use_collision_detection': True,
            'FollowPath.max_allowed_time_to_collision_up_to_carrot': 1.5,
            'FollowPath.approach_velocity_scaling_dist': 0.6, 'FollowPath.min_approach_linear_velocity': 0.12,
        }},
        f'/{ns}/local_costmap/local_costmap': {'ros__parameters': local},
        f'/{ns}/velocity_smoother': {'ros__parameters': {
            'use_sim_time': False, 'smoothing_frequency': 20.0, 'scale_velocities': False,
            'feedback': 'OPEN_LOOP', 'max_velocity': [vmax, 0.0, wmax], 'min_velocity': [0.0, 0.0, -wmax],
            'max_accel': [0.4, 0.0, 1.0], 'max_decel': [-0.6, 0.0, -1.5],
            'odom_topic': odom, 'odom_duration': 0.1, 'deadband_velocity': [0.0, 0.0, 0.0],
            'velocity_timeout': 0.5,
        }},
    }
    if controller == 'mppi':
        control = params[f'/{ns}/controller_server']['ros__parameters']
        for k in [k for k in control if k.startswith('FollowPath.')]:
            del control[k]
        control.update(mppi_params(vmax, wmax, controller_hz, mppi_batch, *local_inflation))
    if experimental_turn:
        control=params[f'/{ns}/controller_server']['ros__parameters']
        control.update({'FollowPath.plugin':'qazbot_mc_turn::Controller',
                        'FollowPath.mc_turn_tolerance':float(L('yaw_tol'))*0.8,
                        'FollowPath.mc_turn_lead_time':0.20,
                        'progress_checker.plugin':'nav2_controller::PoseProgressChecker',
                        'progress_checker.required_movement_angle':0.1,
                        'goal_checker.plugin':'qazbot_mc_turn::SettledGoal',
                        'goal_checker.stateful':False,
                        'goal_checker.rot_stopped_velocity':0.03,
                        'goal_checker.trans_stopped_velocity':0.02})
        smoother=params[f'/{ns}/velocity_smoother']['ros__parameters']
        # MC owns the angular ramp. Preserve linear smoothing; pass zero without an extra 0.5 s tail.
        smoother['max_accel']=[0.4,0.0,40.0]
        smoother['max_decel']=[-0.6,0.0,-40.0]
        if linear_decel is not None:
            decel=float(linear_decel)
            if not 0.1<=decel<=4.:raise ValueError('invalid SIM linear deceleration')
            smoother['max_decel'][0]=-decel
        if experimental_walk:
            lead=float(os.environ.get('QAZBOT_SIM_MC_WALK_LEAD','0.45'))
            if not 0<=lead<=1.5:raise ValueError('invalid SIM walk lead')
            control.update({'FollowPath.mc_walk_brake':True,'FollowPath.mc_walk_lead_time':lead})
    if pose_refine:
        control=params[f'/{ns}/controller_server']['ros__parameters']
        control.update({'FollowPath.plugin':'qazbot_pose_refine::Controller',
                        'FollowPath.refine_entry':float(L('xy_tol'))*.6,
                        'FollowPath.refine_exit':float(L('xy_tol'))*2.,
                        'FollowPath.refine_yaw_stop':float(L('yaw_tol'))*.6,
                        'goal_checker.plugin':'nav2_controller::StoppedGoalChecker',
                        'goal_checker.stateful':False,
                        'goal_checker.rot_stopped_velocity':.03,
                        'goal_checker.trans_stopped_velocity':.02})
    logdir = os.environ.get('ROS_LOG_DIR', os.path.expanduser('~/.ros/log'))
    os.makedirs(logdir, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', prefix='qazbot_ctl_', suffix='.yaml', dir=logdir, delete=False) as f:
        yaml.safe_dump(params, f)
        path = f.name
    tf_ns = context.launch_configurations.get('tf_ns') or ns
    remaps = [('/tf', f'/{tf_ns}/tf'), ('/tf_static', f'/{tf_ns}/tf_static')]
    need = (['nav2_mppi_controller'] if controller == 'mppi' else []) + \
           (['spatio_temporal_voxel_layer'] if obstacle_layer == 'stvl' and scan else [])
    ext_env = {'additional_env': nav_ext_env(need)} if need else {}   # default rpp/i1: environment unchanged
    actions = [
        Node(package='nav2_controller', executable='controller_server', namespace=ns, name='controller_server',
             output='screen', remappings=remaps + [('cmd_vel', 'cmd_vel_nav')], parameters=[ParameterFile(path)],
             **ext_env),
        Node(package='nav2_velocity_smoother', executable='velocity_smoother', namespace=ns, name='velocity_smoother',
             output='screen', remappings=remaps + [('cmd_vel', 'cmd_vel_nav'), ('cmd_vel_smoothed', L('output_topic'))],
             parameters=[ParameterFile(path)]),
        Node(package='nav2_lifecycle_manager', executable='lifecycle_manager', namespace=ns,
             name='lifecycle_manager_control', output='screen',
             parameters=[{'autostart': True, 'node_names': ['controller_server', 'velocity_smoother']}]),
    ]
    return actions if raw else staggered(actions)


def switch_arguments():
    return [
        DeclareLaunchArgument('controller', default_value='rpp', choices=list(CONTROLLERS),
                              description='P25: rpp (current) | mppi (nav2_mppi_controller 1.1.18, overlay nav_ext_ws)'),
        DeclareLaunchArgument('obstacle_layer', default_value='i1', choices=list(OBSTACLE_LAYERS),
                              description='P25: i1 (ObstacleLayer marking+bounded clearing) | stvl (spatio_temporal_voxel_layer)'),
        DeclareLaunchArgument('mppi_hz', default_value='20.0', description='P25: controller_frequency with MPPI; model_dt=1/hz, horizon 2 s'),
        DeclareLaunchArgument('mppi_batch', default_value='1000', description='P25: MPPI batch_size'),
    ]


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument('ns', default_value='qazbot_d1_map'),
        DeclareLaunchArgument('robot_radius', description='Body envelope radius in metres; no default'),
        DeclareLaunchArgument('max_linear', default_value='0.3', description='candidate, m/s'),
        DeclareLaunchArgument('max_angular', default_value='0.6', description='rad/s; S3b 2026-10-22: 0.5 stalled CW in place, 0.6 turns both ways'),
