# What the physical X2 runs. Source of truth: docs/evidence/x2_twin_20261030/snapshot/actual_parameters.json on origin/robot/stable
# (live ros2 param dump of the X2, 2026-10-30, after the rollback; Nav2 1.1.18) + PINNED_ROBOT_BASELINE_20261030.md. NOT the 2026-10-29 documentation
# (map first_map_nav2_v3, xy 0.20 / yaw 0.35): those values were superseded. tests/nightly/test_contract.py re-derives every value below from the snapshot.
ROBOT_MAP=d1_qazbot_20261029
# sha256 of maps/d1_qazbot_20261029/map.pgm; equals localization_trust.expected_map_sha256 on the robot.
ROBOT_MAP_SHA256=72ee4094b394241e7b2761878774efbdd99e93731d7cb52709b2231c3975b354
# controller_server goal_checker.xy_goal_tolerance / yaw_goal_tolerance (SimpleGoalChecker, stateful) as run on the robot.
ROBOT_XY_TOL=0.35
ROBOT_YAW_TOL=0.17
ROBOT_REF=origin/robot/stable
