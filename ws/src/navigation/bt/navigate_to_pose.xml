<!-- No motion recoveries (no spin/backup/wait). Replans at 1 Hz; a failed replan keeps the last valid path. -->
<!-- If following still fails: clear LOCAL+GLOBAL costmaps (person trails never cleared by bounded I1 clearing; real in-FOV obstacles re-mark within one scan) and retry, max 4 (operator 2026-10-29). -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Fallback name="ReplanOrKeepPath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <AlwaysSuccess/>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </PipelineSequence>
      <Sequence name="ClearStaleMarks">
        <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalCostmap" service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
