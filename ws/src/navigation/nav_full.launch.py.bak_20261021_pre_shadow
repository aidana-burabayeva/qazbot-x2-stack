"""Full Nav2 candidate: private velocity output, no hardware MC adapter."""
import math
import hashlib
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from launch_stagger import staggered  # noqa: E402
import tempfile

import yaml
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, OpaqueFunction
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node
from launch_ros.descriptions import ParameterFile

NS = 'qazbot_d1_map'
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)


def setup(context):
    prefix = os.environ.get('QAZBOT_SMAC_PREFIX')
    if not prefix:
        raise RuntimeError('Full navigation requires the qualified Smac bounds overlay; source env.sh with QAZBOT_SMAC_PREFIX')
    with open(os.path.join(prefix,'qazbot_bounds_fix.json')) as f:
        evidence=json.load(f)
    library=os.path.join(prefix,'lib','libnav2_smac_planner_2d.so')
    with open(library,'rb') as f:
        if hashlib.sha256(f.read()).hexdigest()!=evidence['library_sha256']:
            raise RuntimeError('Smac library differs from its tested manifest')
    from ament_index_python.packages import get_package_prefix
    if os.path.realpath(get_package_prefix('nav2_smac_planner'))!=os.path.realpath(prefix):
        raise RuntimeError('Qualified Smac prefix is not selected in the ament index')
    outer = LaunchConfiguration('ns').perform(context)
    NS = outer + '/nav2'
    if not LaunchConfiguration('scan_topic').perform(context):
        raise ValueError('Full navigation requires an obstacle scan')
    radius = float(LaunchConfiguration('robot_radius').perform(context))
    if not math.isfinite(radius) or radius <= 0:
        raise ValueError('robot_radius must be the positive body envelope about the LIO base')
    with open(LaunchConfiguration('map_yaml').perform(context)) as f:
        resolution = float(yaml.safe_load(f)['resolution'])
    # The costmap marks a cell inscribed by the distance between cell centres,
    # while the occupied area is the whole cell. A path on cell centres is thus
    # up to half a cell diagonal closer to an obstacle than the radius asks.
    margin = resolution / math.sqrt(2) if LaunchConfiguration('cell_margin').perform(context) == 'true' else 0.0
    inscribed = radius + margin
    params = {
        f'/{NS}/planner_server': {'ros__parameters': {
            'use_sim_time': False,
            'planner_plugins': ['GridBased'],
            'GridBased.plugin': 'nav2_smac_planner/SmacPlanner2D',
            'GridBased.allow_unknown': False,
            'GridBased.tolerance': 0.0,
        }},
        f'/{NS}/global_costmap/global_costmap': {'ros__parameters': {
            'use_sim_time': False,
            'global_frame': 'map', 'robot_base_frame': 'base_footprint',
            'robot_radius': inscribed, 'footprint_padding': 0.01,
            'track_unknown_space': True,
            'plugins': ['static_layer', 'inflation_layer'],
            'static_layer.plugin': 'nav2_costmap_2d::StaticLayer',
            'static_layer.map_topic': f'/{outer}/map',
            'static_layer.map_subscribe_transient_local': True,
            'static_layer.footprint_clearing_enabled': False,
            'inflation_layer.plugin': 'nav2_costmap_2d::InflationLayer',
            'inflation_layer.inflation_radius': inscribed + 0.01,
            'inflation_layer.inflate_around_unknown': True,
        }},
        f'/{NS}/bt_navigator': {'ros__parameters': {
            'use_sim_time': False,
            'global_frame': 'map', 'robot_base_frame': 'base_footprint',
            'odom_topic': LaunchConfiguration('odom_topic').perform(context),
            'default_nav_to_pose_bt_xml': os.path.join(HERE, 'bt', 'navigate_to_pose.xml'),
            'default_nav_through_poses_bt_xml': os.path.join(HERE, 'bt', 'unsupported_through_poses.xml'),
            'plugin_lib_names': ['nav2_compute_path_to_pose_action_bt_node',
                                 'nav2_follow_path_action_bt_node'],
        }},
    }
    logdir = os.environ.get('ROS_LOG_DIR', os.path.expanduser('~/.ros/log'))
    os.makedirs(logdir, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', prefix='qazbot_plan_', suffix='.yaml',
                                     dir=logdir, delete=False) as f:
        yaml.safe_dump(params, f)
        path = f.name
    remaps = [('/tf', f'/{outer}/tf'), ('/tf_static', f'/{outer}/tf_static')]
    navigation = [
        Node(package='nav2_planner', executable='planner_server', namespace=NS,
             name='planner_server', output='screen', remappings=remaps,
             parameters=[ParameterFile(path)]),
        Node(package='nav2_bt_navigator', executable='bt_navigator', namespace=NS,
             name='bt_navigator', output='screen', remappings=remaps,
             parameters=[ParameterFile(path)]),
        Node(package='nav2_lifecycle_manager', executable='lifecycle_manager', namespace=NS,
             name='lifecycle_manager_navigation', output='screen',
             parameters=[{'autostart': True, 'node_names': ['planner_server', 'bt_navigator']}]),
    ]
    # Reuse the existing controller configuration; one lifecycle owner for the full stack.
    import importlib.util
    spec = importlib.util.spec_from_file_location('qazbot_control_launch', os.path.join(HERE,'nav_control.launch.py'))
    ctl = importlib.util.module_from_spec(spec); spec.loader.exec_module(ctl)
    context.launch_configurations['ns'] = NS
    context.launch_configurations['tf_ns'] = outer
    context.launch_configurations['output_topic'] = '/' + outer + '/cmd_vel'
    control = ctl.setup(context, raw=True)[:-1]
    context.launch_configurations['ns'] = outer
    nodes = control + navigation[:2]
    manager_prefix = []
    if os.environ.get('QAZBOT_MANAGER_GDB') == '1':
        if os.environ.get('ROS_DOMAIN_ID') != '87' or os.environ.get('ROS_LOCALHOST_ONLY') != '1':
            raise RuntimeError('Manager debugger is restricted to isolated model domain 87')
        manager_prefix = ['gdb -batch -ex "handle SIGINT nostop noprint pass" -ex "handle SIGTERM nostop noprint pass" -ex run -ex "thread apply all bt" --args']
    nodes.append(Node(package='nav2_lifecycle_manager', executable='lifecycle_manager', namespace=NS,
                      name='lifecycle_manager_navigation', output='screen', prefix=manager_prefix,
                      # OnProcessExit terminates the whole group. There is no per-node respawn.
                      # Never start lifecycle reconnection while that group is shutting down.
                      parameters=[{'autostart':True,'attempt_respawn_reconnection':False,
                                   'node_names':['controller_server','velocity_smoother','planner_server','bt_navigator']}]))
    from launch.actions import RegisterEventHandler, EmitEvent, ExecuteProcess
    nodes.append(ExecuteProcess(cmd=['python3',os.path.join(HERE,'goal_coordinator.py'),'--ros-args','-r','__ns:=/' + outer], output='screen'))
    from launch.event_handlers import OnProcessExit
    from launch.events import Shutdown
    guards = [RegisterEventHandler(OnProcessExit(target_action=node,
                  on_exit=[EmitEvent(event=Shutdown(reason='Full Nav2 process exited'))])) for node in nodes]
    return guards + staggered(nodes)


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument('ns', default_value='qazbot_d1_map'),
        DeclareLaunchArgument('scan_topic', description='Required obstacle scan'),
        DeclareLaunchArgument('odom_topic', description='Required valid local odometry'),
        DeclareLaunchArgument('max_linear', default_value='0.3'),
        DeclareLaunchArgument('max_angular', default_value='0.5'),
        DeclareLaunchArgument('xy_tol', default_value='0.10'),
        DeclareLaunchArgument('yaw_tol', default_value='0.10'),
        DeclareLaunchArgument('robot_radius', description='Body envelope radius in metres; no default'),
        DeclareLaunchArgument('map_yaml', default_value=os.path.join(ROOT, 'maps', 'first_map_nav2_v1', 'map.yaml')),
        DeclareLaunchArgument('cell_margin', default_value='true',
                              description='Add half a cell diagonal to the inscribed radius'),
        OpaqueFunction(function=setup),
    ])
