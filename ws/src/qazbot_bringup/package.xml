<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qazbot_bringup</name>
  <version>0.1.0</version>
  <description>Canonical X2 navigation bringup (x2_navigation.launch.xml: mode lab|production, profile, odom_source), runtime environment and DDS profiles, build manifest.</description>
  <maintainer email="qazbot@users.noreply.github.com">QazBot</maintainer>
  <license>Proprietary</license>

  <!-- fast_lio is third-party (ws/third_party.repos, built by ws/third_party/build_third_party.sh); it has no rosdep key,
       so it is intentionally NOT an exec_depend. It is resolved at launch (find-pkg-prefix fast_lio). -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>qazbot_localization</exec_depend>
  <exec_depend>qazbot_navigation</exec_depend>
  <exec_depend>qazbot_motion_control</exec_depend>
  <exec_depend>qazbot_lidar_projector</exec_depend>
  <exec_depend>qazbot_maps</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
