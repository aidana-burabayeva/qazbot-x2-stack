"""Exact-clearance regression for the plan-only stack. Never moves anything."""
import json, math, sys, random
import numpy as np, yaml
from PIL import Image
from scipy.ndimage import distance_transform_edt, label
import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from nav2_msgs.action import ComputePathToPose, NavigateToPose
from action_msgs.msg import GoalStatus
from nav_msgs.msg import Path

MAP, R, OUT = sys.argv[1], float(sys.argv[2]), sys.argv[3]
meta = yaml.safe_load(open(MAP)); res = float(meta['resolution']); ox, oy = meta['origin'][:2]
img = np.asarray(Image.open(MAP.rsplit('/', 1)[0] + '/' + meta['image']))
occ = (255 - img) / 255.0
free = np.flipud(occ < meta['free_thresh'])             # row 0 = lowest y
H, W = free.shape
K = 10                                                   # supersample: 5 mm
fine_free = np.kron(free, np.ones((K, K), bool))
fine_dist = distance_transform_edt(fine_free) * (res / K)  # to nearest non-free cell square
def exact_clearance(xy):
    c = np.floor((xy[:, 0] - ox) / (res / K)).astype(int); r = np.floor((xy[:, 1] - oy) / (res / K)).astype(int)
    inside = (r >= 0) & (r < H * K) & (c >= 0) & (c < W * K)
    if not inside.all(): return -1.0
    return float(fine_dist[r, c].min())
def densify(path):
    out = [path[0]]
    for a, b in zip(path, path[1:]):
        n = max(2, math.ceil(math.dist(a, b) / (res / K)) + 1); out.extend(np.linspace(a, b, n)[1:])
    return np.asarray(out)
# candidate endpoints: free cells whose exact clearance >= R + half diagonal, in the largest component
cell_d = distance_transform_edt(free) * res
lab, n = label(free); big = np.argmax(np.bincount(lab.ravel())[1:]) + 1
ok = (lab == big) & (fine_dist[K // 2::K, K // 2::K] >= R + res / math.sqrt(2) + 0.0)
rows, cols = np.nonzero(ok)
random.seed(7); idx = random.sample(range(len(rows)), 40)
pts = [(ox + (cols[i] + .5) * res, oy + (rows[i] + .5) * res) for i in idx]
pairs = [(pts[i], pts[i + 1]) for i in range(0, 40, 2)]

rclpy.init(); node = Node('qazbot_clearance_harness')
cl = ActionClient(node, ComputePathToPose, '/qazbot_d1_map/compute_path_to_pose')
nav = ActionClient(node, NavigateToPose, '/qazbot_d1_map/navigate_to_pose')
plans = []
node.create_subscription(Path, '/qazbot_d1_map/plan', plans.append, 10)
def wait(f, t=30):
    rclpy.spin_until_future_complete(node, f, timeout_sec=t); assert f.done(), 'timeout'; return f.result()
def pose(msg, xy):
    msg.header.frame_id = 'map'; msg.pose.position.x, msg.pose.position.y = float(xy[0]), float(xy[1]); msg.pose.orientation.w = 1.0
assert cl.wait_for_server(timeout_sec=30) and nav.wait_for_server(timeout_sec=30)
res_list = []
for s, g in pairs:
    req = ComputePathToPose.Goal(); req.use_start = True; req.planner_id = 'GridBased'
    pose(req.start, s); pose(req.goal, g)
    h = wait(cl.send_goal_async(req)); r = wait(h.get_result_async())
    p = [[q.pose.position.x, q.pose.position.y] for q in r.result.path.poses]
    ok_ = r.status == GoalStatus.STATUS_SUCCEEDED and len(p) > 1
    res_list.append({'start': s, 'goal': g, 'ok': ok_, 'len': sum(math.dist(a, b) for a, b in zip(p, p[1:])) if ok_ else None,
                     'clear': exact_clearance(densify(p)) if ok_ else None})
done = [r for r in res_list if r['ok']]
cl_ = [r['clear'] for r in done]
summary = {'radius': R, 'pairs': len(pairs), 'succeeded': len(done),
           'min_clear': min(cl_) if cl_ else None, 'p5_clear': float(np.percentile(cl_, 5)) if cl_ else None,
           'violations_lt_R': sum(c < R for c in cl_), 'violations_lt_R_minus_1mm': sum(c < R - 1e-3 for c in cl_)}
# NavigateToPose plumbing: plan-only tree must succeed and publish /plan
g = NavigateToPose.Goal(); pose(g.pose, (0.175, -5.925)); g.pose.header.stamp = node.get_clock().now().to_msg()
plans.clear(); h = wait(nav.send_goal_async(g)); nr = wait(h.get_result_async(), 40)
for _ in range(10): rclpy.spin_once(node, timeout_sec=0.1)
summary['navigate_to_pose_status'] = nr.status; summary['plan_msgs_after_navigate'] = len(plans)
json.dump({'summary': summary, 'cases': res_list}, open(OUT, 'w'), indent=1)
print(json.dumps(summary))
