# the ONE colcon workspace, built in place by ws/tools/build.sh, and the third-party checkouts it imports
/ws/build/
/ws/install/
/ws/log/
/ws/src/third_party/*
!/ws/src/third_party/COLCON_IGNORE
# motion owner lock of x2_motion_adapter (lock_path default ~/control_backend/run/ = <repo>/run on the robot)
/run/
# any other colcon / python build products (accidents)
build/
install/
log/
build_*/
__pycache__/
*.pyc
.pytest_cache/
.coverage
# task registry (ws/tools/task_register.sh)
.task/
# data, evidence and backups never live in this repository (archive: /home/agi/qazbot_archive/<sha>/)
*.bag
*.db3
*.mcap
*.npy
*.tar.gz
*.tgz
*.zip
*.bak*
*.orig
core
core.[0-9]*
fastdds.log
logs/
runtime/
runtime_x86
candidates/
vendor
vendor_snapshots/
