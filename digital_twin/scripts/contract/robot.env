# What the physical X2 uses (source: docs/X2_QUICKSTART_BRINGUP_RU.md; the Trust node on the robot enforces expected_map_sha256).
# nightly compares the twin map against these and records the result in meta.env.
ROBOT_MAP=first_map_nav2_v3
ROBOT_MAP_SHA256=f6032f75ffd386361993a4b4864cf0816713fc27f6d037c88d929ae5d48562fb
# Goal checker the operator runs on the robot (docs/HANDOFF.md 2026-10-29: xy 0.20 m, yaw_tol:=0.35). nav_full defaults are 0.10/0.10,
# below the in-place-turn centre drift of the MC (0.16-0.23 m measured); the twin must run the robot's values to be comparable.
ROBOT_XY_TOL=0.20
ROBOT_YAW_TOL=0.35
