#!/usr/bin/env python3
"""ROS wrapper for loc_trust.TrustEvaluator. Subscribes only (plus its own status topics); never publishes velocity.

Namespace /qazbot_d1_map, node `localization_trust`:
  in : amcl_pose, particle_cloud, map (served grid, identity check T8), /qazbot_lio/scan,
       /qazbot_lio/odom_level, /qazbot_d1_map/tf (map->odom, odom->base_footprint)
       initialpose (strict: confirm_anchor; Go2: valid post-seed AMCL required)
  out: ~/trusted (Bool, 5 Hz) = MOTION_OK (READY and fresh critical inputs),
       ~/status (String JSON: trusted, ready, motion_ok, ready_cause, reasons (motion-blocking / not-ready),
       diagnostics (T2/T3/T4/T6/T7 after READY, never blocking), metrics)
  srv: ~/confirm_anchor   operator verified the pose (floor mark / known start); fixes the T6 anchor and gates READY
       ~/arm_check        called by the coordinator for every NEW goal request: input loss still present now clears
                          READY (prolonged loss); success = READY and MOTION_OK. The ambiguity scan is diagnostic (T7).
       ~/baseline_start, ~/baseline_finish   OPTIONAL median scan score at the confirmed standing pose (stage F0);
                          without it the READY scan floor is hit_min_abs
  file: param pose_store (default '' = off; run_trust.sh sets pose_store.DEFAULT_PATH): the CONFIRMED pose
        (map pose, AMCL covariance, map sha256) is written atomically at the READY rising edge and at a clean
        shutdown while READY with clean checks; seed_pose.py --from-file re-seeds it once after a relaunch.
"""
import json
import math
import os
import signal
import sys
import threading
import time
from contextlib import nullcontext
from collections import deque

import numpy as np
import rclpy
from geometry_msgs.msg import PoseWithCovarianceStamped
from nav2_msgs.msg import ParticleCloud
from nav_msgs.msg import OccupancyGrid, Odometry
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import LaserScan
from std_msgs.msg import Bool, String
from std_srvs.srv import Empty, Trigger
from tf2_msgs.msg import TFMessage

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from source_stamp import SourceStamp
import loc_trust as L  # noqa: E402
import pose_store  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))


def yaw_of(q):
    return math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))


class TrustNode(Node):
    def __init__(self):
        super().__init__('localization_trust', namespace='qazbot_d1_map')
        p = self.declare_parameter
        grid_yaml = p('map_yaml', os.path.join(HERE, '..', 'maps', 'first_map_nav2_v2', 'map.yaml')).value
        cfg = L.TrustConfig(**{k: p(k, v).value for k, v in L.TrustConfig().__dict__.items()})
        self.ev = L.TrustEvaluator(L.OccGrid.from_pgm(os.path.abspath(grid_yaml)), cfg)
        self.cfg = cfg
        self.seed_stamp = None
        # Stationary initialization helper; service requests update AMCL, never motion.
        self.seed_update_enabled = p('go2_nomotion_on_initialpose', True).value
        self.seed_update = None
        self.seed_update_future = None
        self.scan_received = float('-inf')
        self.nomotion = self.create_client(Empty, 'request_nomotion_update')
        self.map_sha256 = pose_store.map_image_sha256(grid_yaml)
        expected = p('expected_map_sha256', '').value
        self.file_mismatch = 'image_sha256' if expected and expected != self.map_sha256 else ''
        self.map_ok = None                    # served grid not seen yet
        self.saver = pose_store.ConfirmedPoseSaver(p('pose_store', '').value, self.map_sha256,
                                                   lambda text: self.get_logger().info(text))
        if cfg.degenerate_budget_m > 0:
            self.get_logger().warn(f'EXPERIMENTAL degenerate_budget_m={cfg.degenerate_budget_m} m is enabled')
        self.mo = self.odom = None
        self.mo_t = self.odom_t = self.odom_msg_t = self.amcl_t = self.scan_t = float('-inf')
        self.cov = self.cloud = self.scan_pts = self.odom_msg_pose = None
        self.cloud_t = float('-inf')
        self.stamps = {k: SourceStamp() for k in ('map', 'odom', 'odom_msg', 'amcl', 'scan', 'cloud')}
        self.odom_hist = []
        self.odom_src = []                    # (source stamp s, odom->base pose) for scan-time/amcl-stamp alignment
        # odom_src must reach back past the oldest amcl_pose stamp still of interest: AMCL output latency is
        # bounded by pose_max_age_moving_s (beyond it a due AMCL is stale anyway) + 1 s for the scan/TF delivery
        # margin; at 10 Hz TF this is ~40 entries.
        self.odom_src_span = cfg.pose_max_age_moving_s + 1.0
        self.amcl_src = None                  # amcl_pose source stamp
        self.odom_at_amcl = self.odom_at_cloud = None
        self.scan_src = None
        self.baseline_scores = None
        self.lock = threading.Lock()          # evaluator state: 5 Hz tick vs. service thread (READY transitions)
        self.input_lock=threading.RLock()
        self.pending_map_steps=deque()
        # Receive data independently of the evaluator/service executor. Keeping
        # latest-only queues is useful only when their callbacks can actually run.
        self.input_node=Node('localization_trust_inputs',namespace=self.get_namespace())
        self.input_callbacks={}
        def subscribe(typ,topic,callback,qos):
            def receive(message):
                started=time.monotonic()
                with self.input_lock:callback(message)
                finished=time.monotonic()
                previous=self.input_callbacks.get(callback.__name__,{})
                self.input_callbacks[callback.__name__]=dict(
                    count=previous.get('count',0)+1, duration_s=finished-started,
                    max_duration_s=max(previous.get('max_duration_s',0.),finished-started),
                    received=started)
            return self.input_node.create_subscription(typ,topic,receive,qos)
        be = QoSProfile(depth=1, reliability=ReliabilityPolicy.BEST_EFFORT)
        subscribe(TFMessage, '/qazbot_d1_map/tf', self._tf,QoSProfile(depth=50))
        subscribe(PoseWithCovarianceStamped, 'amcl_pose', self._amcl,
                                 QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                                            durability=DurabilityPolicy.TRANSIENT_LOCAL))
        subscribe(Odometry, '/qazbot_lio/odom_level', self._odom, be)
        subscribe(ParticleCloud, 'particle_cloud', self._cloud, be)
        subscribe(LaserScan, '/qazbot_lio/scan', self._scan, be)
        subscribe(OccupancyGrid, p('map_topic', 'map').value, self._map,
                                 QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                                            durability=DurabilityPolicy.TRANSIENT_LOCAL))
        subscribe(PoseWithCovarianceStamped, 'initialpose', self._initialpose, QoSProfile(depth=1))
        self.pub_ok = self.create_publisher(Bool, '~/trusted', 10)
        self.pub_status = self.create_publisher(String, '~/status', 10)
        # Services run in their own callback group on a second executor thread: arm_check (ambiguity scan,
        # ~0.9 s on the X2 Jetson, measured 2026-10-21) must not stall the 5 Hz verdict, otherwise every
        # consumer (adapter, coordinator: trust_max_age 0.6 s) sees trust expire during goal arming.
        from rclpy.callback_groups import MutuallyExclusiveCallbackGroup
        srv = MutuallyExclusiveCallbackGroup()
        self.create_service(Trigger, '~/confirm_anchor', self._confirm, callback_group=srv)
        self.create_service(Trigger, '~/arm_check', self._arm, callback_group=srv)
        self.create_service(Trigger, '~/baseline_start', self._bl_start, callback_group=srv)
        self.create_service(Trigger, '~/baseline_finish', self._bl_finish, callback_group=srv)
        self.create_timer(0.2, self._tick)
        self.get_logger().info(f'localization_trust started, map={grid_yaml}, policy={cfg.admission_policy}')

    def _stamp(self, key, stamp, future=0.0):
        source = stamp.sec + stamp.nanosec * 1e-9
        ros_now=self.get_clock().now().nanoseconds * 1e-9
        previous=self.stamps[key].last
        accepted=self.stamps[key].accept(source,ros_now,time.monotonic(),future)
        if not math.isfinite(accepted):
            rejected=getattr(self,'stamp_rejections',{})
            rejected[key]=dict(count=rejected.get(key,{}).get('count',0)+1,source=source,
                               previous=previous,ros_now=ros_now,allowed_future=future)
            self.stamp_rejections=rejected
        return accepted

    def _tf(self, m):
        now = time.monotonic()
        for t in m.transforms:
            pair = (t.header.frame_id, t.child_frame_id)
            tr, q = t.transform.translation, t.transform.rotation
            if pair == ('map', 'odom'):
                mt = self._stamp('map', t.header.stamp, 1.0)
                if mt != float('-inf'):        # accepted update: per-update T5 step check (latched in the evaluator)
                    # Never wait for diagnostic evaluation while receiving TF.
                    # Preserve every accepted correction for the next evaluation.
                    self.pending_map_steps.append((tr.x,tr.y,yaw_of(q)))
                self.mo, self.mo_t = (tr.x, tr.y, yaw_of(q)), mt
            elif pair == ('odom', 'base_footprint'):
                self.odom_t = self._stamp('odom', t.header.stamp)
                self.odom = (tr.x, tr.y, yaw_of(q))
                src = t.header.stamp.sec + t.header.stamp.nanosec * 1e-9
                self.odom_src = [(a, b) for a, b in self.odom_src if src - a <= self.odom_src_span and a < src] + [(src, self.odom)]
                self.odom_hist = [(a, b) for a, b in self.odom_hist if now - a <= 0.6] + [(now, self.odom)]

    def _initialpose(self, m):
        if self.cfg.admission_policy == 'go2':
            values = [m.pose.pose.position.x, m.pose.pose.position.y,
                      m.pose.pose.orientation.x, m.pose.pose.orientation.y,
                      m.pose.pose.orientation.z, m.pose.pose.orientation.w]
            # Invalid reinitialization must revoke readiness too.
            self.seed_stamp = None
            if m.header.frame_id == 'map' and np.isfinite(values).all() and np.linalg.norm(values[2:]) > 1e-6:
                self.seed_stamp = m.header.stamp.sec + m.header.stamp.nanosec * 1e-9
            self.cov, self.mo = None, None
            self.amcl_t = self.mo_t = float('-inf')
        if self.seed_update_future is not None and not self.seed_update_future.done():
            self.seed_update_future.cancel()
        self.seed_update_future = None
        self.seed_update = (dict(start=time.monotonic(), attempts=0, last_request=float('-inf'), scan=None)
                            if self.seed_update_enabled and self.cfg.admission_policy == 'go2'
                            and self.seed_stamp is not None else None)
        with self.lock:
            self.ev.relocalize()
        self.get_logger().warn('initialpose received: READY cleared; policy=' + self.cfg.admission_policy)

    def _odom(self,m):
        if m.header.frame_id!='odom' or m.child_frame_id!='base_footprint':
            self.odom_msg_t=float('-inf');return
        self.odom_msg_t=self._stamp('odom_msg',m.header.stamp)
        q=m.pose.pose.orientation;self.odom_msg_pose=(m.pose.pose.position.x,m.pose.pose.position.y,yaw_of(q))

    def _map(self, m):
        if m.header.frame_id != 'map':
            self.map_ok = 'frame_id'
            return
        o = m.info.origin.position
        self.map_ok = self.file_mismatch or L.map_identity(self.ev.grid, m.info.resolution, (o.x, o.y),
                                                           m.info.width, m.info.height, m.data)
        if self.map_ok:
            self.get_logger().error('served map differs from the trust grid: ' + self.map_ok)

    def _amcl(self, m):
        if m.header.frame_id!='map':
            self.cov=None;self.amcl_t=float('-inf');return
        t = self._stamp('amcl', m.header.stamp)
        if t == float('-inf'):                # rejected / duplicate / old stamp: ignore the message entirely, keep
            return                            # previous cov, stamp and odom reference (no due-timer reset either)
        if self.cfg.admission_policy == 'go2':
            src = m.header.stamp.sec + m.header.stamp.nanosec * 1e-9
            q = m.pose.pose.orientation
            values = [m.pose.pose.position.x, m.pose.pose.position.y, q.x, q.y, q.z, q.w]
            if (not np.isfinite(values).all() or np.linalg.norm(values[2:]) <= 1e-6 or
                    (self.seed_stamp is None and not self.ev.initialized) or
                    (self.seed_stamp is not None and src < self.seed_stamp)):
                return
            if self.seed_stamp is not None:
                with self.lock:
                    self.ev.accept_initialization()
                self.seed_stamp = None  # one initialization per initialpose event
        self.cov, self.amcl_t = list(m.pose.covariance), t
        self.amcl_src = m.header.stamp.sec + m.header.stamp.nanosec * 1e-9
        # odom pose AMCL worked from (its scan stamp); history miss -> odom at receipt (latest known)
        self.odom_at_amcl = self._odom_at(self.amcl_src) or self.odom

    def _cloud(self, m):
        if m.particles and m.header.frame_id == 'map':
            t = self._stamp('cloud', m.header.stamp)
            if t == float('-inf'):              # rejected / duplicate stamp: ignore, keep previous cloud/reference
                return
            self.cloud = (np.array([[q.pose.position.x, q.pose.position.y] for q in m.particles]),
                          np.array([q.weight for q in m.particles]))
            self.cloud_t = t
            # the cloud is stamped with AMCL's now(): odom at receipt is the closest available reference
            self.odom_at_cloud = self.odom

    def _scan(self, m):
        self.last_scan_frame=m.header.frame_id
        if m.header.frame_id!='base_footprint':
            self.scan_frame_rejections=getattr(self,'scan_frame_rejections',0)+1
            self.scan_pts=None;self.scan_t=float('-inf');return
        self.scan_pts = L.scan_endpoints(m.ranges, m.angle_min, m.angle_increment, self.cfg.rmin, self.cfg.rmax)
        self.scan_t = self._stamp('scan', m.header.stamp)
        self.scan_src = m.header.stamp.sec + m.header.stamp.nanosec * 1e-9
        if self.scan_t != float('-inf'):
            self.scan_received = time.monotonic()

    def _odom_at_scan(self):
        """odom->base_footprint interpolated at the scan source stamp; None if the scan is outside the history."""
        return self._odom_at(self.scan_src)

    def _odom_at(self, t):
        h = self.odom_src
        if t is None or not h or not h[0][0] <= t <= h[-1][0]:
            return None
        for (t0, a), (t1, b) in zip(h, h[1:]):
            if t0 <= t <= t1:
                f = (t - t0) / max(t1 - t0, 1e-9)
                return (a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]), L.wrap(a[2] + f * L.wrap(b[2] - a[2])))
        return h[-1][1]

    def _moving(self):
        if len(self.odom_hist) < 2:
            return False
        (t0, a), (t1, b) = self.odom_hist[0], self.odom_hist[-1]
        dt = max(t1 - t0, 1e-3)
        return (math.hypot(b[0] - a[0], b[1] - a[1]) / dt > 0.02) or (abs(L.wrap(b[2] - a[2])) / dt > 0.03)

    def _inputs(self):
        with getattr(self,'input_lock',nullcontext()):
            return self._inputs_snapshot()

    def _inputs_snapshot(self):
        # an amcl/cloud message that arrived before any odom: pin the reference to the first odom seen
        if self.odom is not None:
            if self.cov is not None and self.odom_at_amcl is None:
                self.odom_at_amcl = self.odom
            if self.cloud is not None and self.odom_at_cloud is None:
                self.odom_at_cloud = self.odom
        return L.Inputs(now=time.monotonic(), map_odom=self.mo, map_odom_stamp=self.mo_t, odom_base=self.odom, odom_stamp=self.odom_t, odom_msg_stamp=self.odom_msg_t,
                        amcl_cov=self.cov, amcl_stamp=self.amcl_t,
                        cloud_xy=None if self.cloud is None else self.cloud[0],
                        cloud_w=None if self.cloud is None else self.cloud[1], cloud_stamp=self.cloud_t,
                        odom_msg_pose=self.odom_msg_pose, map_ok=self.map_ok, odom_at_scan=self._odom_at_scan(),
                        scan_pts=self.scan_pts, scan_stamp=self.scan_t, moving=self._moving(),
                        odom_at_amcl=self.odom_at_amcl, odom_at_cloud=self.odom_at_cloud)

    def _update_seed_without_motion(self):
        pending = self.seed_update
        if pending is None:
            return
        now = time.monotonic()
        if self.seed_stamp is None:  # only a valid post-seed AMCL message completes initialization
            self.seed_update = self.seed_update_future = None
            return
        if now - pending['start'] > 6.0:
            self.get_logger().warn('initialpose AMCL refresh expired; initialization still required')
            self.seed_update = self.seed_update_future = None
            return
        future = self.seed_update_future
        if future is not None:
            if not future.done() and now - pending['last_request'] < 1.0:
                return
            if not future.done():
                future.cancel()
            elif future.exception() is not None:
                self.get_logger().warn('initialpose AMCL refresh service failed: ' + str(future.exception()))
            self.seed_update_future = None
        # Wait for a NEW, valid scan after the seed, fresh odometry, and a stationary pose.
        # Empty service success itself is not evidence of localization or readiness.
        if (pending['attempts'] >= 3 or now - pending['last_request'] < 0.6 or
                self.scan_received <= pending['start'] or self.scan_src is None or
                self.scan_src < self.seed_stamp or self.scan_src == pending['scan'] or
                not 0 <= now - self.scan_t <= self.cfg.scan_max_age_s or
                not 0 <= now - self.odom_t <= self.cfg.odom_max_age_s or
                self._moving() or not self.nomotion.service_is_ready()):
            return
        pending['attempts'] += 1
        pending['last_request'], pending['scan'] = now, self.scan_src
        self.seed_update_future = self.nomotion.call_async(Empty.Request())
        self.get_logger().info('initialpose: requested AMCL update without motion, attempt ' + str(pending['attempts']))

    def _tick(self):
        with getattr(self,'input_lock',nullcontext()):
            self._update_seed_without_motion()
            inp = self._inputs()
            steps=list(getattr(self,'pending_map_steps',()))
            if hasattr(self,'pending_map_steps'):self.pending_map_steps.clear()
        with self.lock:
            for pose in steps:self.ev.observe_map_odom(pose)
            r = self.ev.evaluate(inp)
        self.saver.on_verdict(r, *self._pose_cov(inp))
        if self.baseline_scores is not None and 'scan_score' in r['metrics']:
            self.baseline_scores.append(r['metrics']['scan_score'])
        self.pub_ok.publish(Bool(data=bool(r['trusted'])))
        self.pub_status.publish(String(data=json.dumps(dict(
            r, admission_policy=self.cfg.admission_policy, initialized=self.ev.initialized,
            ready_cause=self.ev.ready_cause, anchor=self.ev.anchor is not None, baseline=self.ev.baseline, moving=inp.moving,
            map_sha256=self.map_sha256, map_ok=self.map_ok,
            stamp_rejections=getattr(self,'stamp_rejections',{}),
            input_callbacks=dict(getattr(self,'input_callbacks',{})),
            input_ages={key:(inp.now-value if math.isfinite(value) else None) for key,value in
                        dict(scan=inp.scan_stamp,odom=inp.odom_stamp,odom_msg=inp.odom_msg_stamp,map=inp.map_odom_stamp).items()},
            scan_frame=getattr(self,'last_scan_frame',None),scan_frame_rejections=getattr(self,'scan_frame_rejections',0),
            scan_points=None if inp.scan_pts is None else len(inp.scan_pts),
            experimental=dict(degenerate_budget_m=self.cfg.degenerate_budget_m,
                              frozen_window_s=self.cfg.frozen_window_s)), default=float)))

    def _pose_cov(self, inp):
        pose = None if inp.map_odom is None or inp.odom_base is None else L.compose(inp.map_odom, inp.odom_base)
        return pose, inp.amcl_cov, inp.map_ok

    def save_on_shutdown(self):
        with self.lock:
            last = self.ev.last
        self.saver.on_shutdown(last, *self._pose_cov(self._inputs()))

    def _ready(self, resp):
        inp = self._inputs()
        if (inp.map_odom is None or inp.odom_base is None or inp.scan_pts is None or
            not 0 <= inp.now - inp.odom_stamp <= self.cfg.odom_max_age_s or
            not 0 <= inp.now - inp.odom_msg_stamp <= self.cfg.odom_max_age_s or
            not 0 <= inp.now - inp.scan_stamp <= self.cfg.scan_max_age_s or
            not 0 <= inp.now - inp.map_odom_stamp <= self.cfg.tf_max_age_s):
            resp.success, resp.message = False, 'no map->odom / odom / scan yet'
            return None
        return inp

    def _confirm(self, req, resp):
        if self.cfg.admission_policy == 'go2':
            resp.success = self.ev.initialized
            resp.message = 'Go2 profile uses initialpose followed by valid AMCL output; no separate anchor confirmation'
            return resp
        inp = self._ready(resp)
        if inp is not None:
            with self.lock:
                pose = self.ev.confirm_anchor(inp)
            resp.success, resp.message = True, ('anchor (x, y, yaw) = (%.3f, %.3f, %.3f); READY at the next clean '
                                                 'gate evaluation (see status ready / reasons)' % pose)
        return resp

    def _arm(self, req, resp):
        with self.lock:
            loss = self.ev.goal_request()
            ready = self.ev.ready
        if not ready or loss:
            resp.success = False
            resp.message = json.dumps(dict(ready=ready, ready_cause=self.ev.ready_cause, reasons=loss))
            return resp
        inp = self._ready(resp)
        if inp is not None:
            a = self.ev.arm_check(inp)        # outside the lock: ~0.9 s on the Jetson must not stall the tick
            resp.success = True               # ambiguity is a diagnostic (T7) since 2026-10-22
            resp.message = json.dumps(a, default=float)
        return resp

    def _bl_start(self, req, resp):
        self.baseline_scores, resp.success, resp.message = [], True, 'collecting scan scores; stand still at the confirmed pose'
        return resp

    def _bl_finish(self, req, resp):
        if not self.baseline_scores or len(self.baseline_scores) < 20:
            resp.success, resp.message = False, 'fewer than 20 samples'
        else:
            self.ev.set_baseline(self.baseline_scores)
            resp.success = True
            resp.message = 'baseline median %.3f from %d samples (min %.3f)' % (
                self.ev.baseline, len(self.baseline_scores), min(self.baseline_scores))
        self.baseline_scores = None
        return resp


def main():
    from rclpy.executors import MultiThreadedExecutor,SingleThreadedExecutor,ExternalShutdownException
    from rclpy.signals import SignalHandlerOptions
    # Keep the ROS context alive until both executors and their callbacks have
    # stopped. The default signal handler can invalidate it while callbacks
    # are still waiting on DDS entities in worker threads.
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    stopping=threading.Event()
    previous={s:signal.signal(s,lambda *_:stopping.set()) for s in (signal.SIGINT,signal.SIGTERM)}
    node = TrustNode()
    ex = MultiThreadedExecutor(num_threads=2)
    ex.add_node(node)
    inputs=SingleThreadedExecutor();inputs.add_node(node.input_node)
    def receive_inputs():
        try:
            while rclpy.ok() and not stopping.is_set():inputs.spin_once(timeout_sec=.1)
        except ExternalShutdownException:pass
        finally:inputs.shutdown()
    receiver=threading.Thread(target=receive_inputs,name='localization_inputs');receiver.start()
    try:
        while rclpy.ok() and not stopping.is_set():ex.spin_once(timeout_sec=.1)
    except (KeyboardInterrupt,ExternalShutdownException):
        pass
    finally:
        stopping.set();ex.shutdown();receiver.join()
        # No executor can publish another positive verdict after this point.
        if rclpy.ok():node.pub_ok.publish(Bool(data=False))
        node.save_on_shutdown()
        node.input_node.destroy_node()
        node.destroy_node()
        rclpy.try_shutdown()
        for s,handler in previous.items():signal.signal(s,handler)


