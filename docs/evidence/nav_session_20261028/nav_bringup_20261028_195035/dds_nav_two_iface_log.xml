    <consumer>
      <class>FileConsumer</class>
      <property><name>filename</name><value>/home/agi/control_backend/docs/evidence/nav_bringup_20261028_195035/fastdds.log</value></property>
      <property><name>append</name><value>TRUE</value></property>
