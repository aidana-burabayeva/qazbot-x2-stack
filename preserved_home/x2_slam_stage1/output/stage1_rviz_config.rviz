# Stage 1 RViz2 config. Topics: /map (nav_msgs/OccupancyGrid), lidar topic
# /aima/hal/sensor/lidar_chest_front/lidar_pointcloud (T1 discovery report; /home/agi/aimdk topics_and_services).
# Docs: https://x2-aimdk.agibot.com/en/latest/ (RViz Visualization)
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 0.7
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /aima/hal/sensor/lidar_chest_front/lidar_pointcloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Name: Current View
    Saved: ~
