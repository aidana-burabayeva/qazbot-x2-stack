Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Рабочая карта v3
      Enabled: true
      Alpha: 0.85
      Topic:
        Value: /qazbot_sim/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: Лидар симулятора
      Enabled: true
      Topic:
        Value: /qazbot_sim/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.035
      Style: Points
      Color: 255; 80; 80
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Path
      Name: Маршрут Nav2
      Enabled: true
      Topic:
        Value: /qazbot_sim/nav2/plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 220; 40
    - Class: rviz_default_plugins/MarkerArray
      Name: Робот и старт
      Enabled: true
      Topic:
        Value: /qazbot_sim/twin/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Map
      Name: Препятствия Nav2
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /qazbot_sim/nav2/local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /qazbot_sim/rviz_goal
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: map
      Scale: 36
      Angle: 0
      X: -5.3
      Y: 0.2
Window Geometry:
  Width: 1400
  Height: 950
