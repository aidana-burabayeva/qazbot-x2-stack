"""Measurable localization-trust criterion for X2 motion (pure numpy, no ROS imports; tested without a robot).

Why: map->odom being fresh only says AMCL is still publishing. AMCL republishes its last transform forever, also
after it locked onto a symmetric / degenerate place (one straight wall slides along the wall; the 52 degree lidar
sector sees a single wall) or after a wrong seed. Motion may only run while ALL of these hold:

  T1 freshness     map->odom, amcl_pose (while moving), scan are recent.
  T2 covariance    AMCL pose covariance: sigma_xy <= sigma_xy_max, sigma_yaw <= sigma_yaw_max.
  T3 particles     weighted particle spread <= cloud_std_max AND weight farther than second_mode_sep from the main
                   mode <= second_mode_weight_max (two competing hypotheses = ambiguous).
  T4 scan vs map   soft endpoint score S (lidar endpoints against the occupied cells of the D1 map, independent of
                   AMCL's belief) >= max(hit_min_abs, hit_baseline_frac * baseline) and no drop > hit_drop_max
                   against the recent median.
  T5 continuity    map->odom changes <= jump_xy_max / jump_yaw_max per jump_window_s (relocalization jump).
  T6 anchor        the operator confirmed the pose (floor mark / known start); afterwards
                   |pose_map - anchor (+) LIO displacement| <= anchor_xy_base + anchor_xy_per_m * path_length
                   (and the yaw analogue). LIO odometry does not use the map, so a false global lock or a jump
                   shows up as a disagreement that AMCL's own consistency scores cannot see.
  Arm-time check   ambiguity(): the score landscape around the pose must have no competitor farther than
                   ambiguity_sep from the pose whose score is within ambiguity_margin of the best.
                   While a competitor exists (degenerate scene) the robot may only travel degenerate_budget_m
                   on LIO odometry before trust is withdrawn.

Thresholds are CANDIDATES: they are calibrated from the operator's standing baseline (stage F0 of the test plan),
not approved values. Trust withdrawn for any reason is regained only after stable_s of continuous clean
evaluation AND an operator acknowledgement in the adapter (resume service).
"""
import math
import warnings
from dataclasses import dataclass, field

import numpy as np

warnings.filterwarnings('ignore', message='A NumPy version')


@dataclass
class TrustConfig:
    sigma_xy_max: float = 0.20
    sigma_yaw_max: float = 0.15
    cloud_std_max: float = 0.25
    second_mode_sep: float = 0.50
    second_mode_weight_max: float = 0.10
    score_sigma: float = 0.05            # m, soft-hit width (one map cell)
    rmin: float = 0.5
    rmax: float = 8.0
    hit_min_abs: float = 0.35
    hit_baseline_frac: float = 0.80
    hit_drop_max: float = 0.15
    jump_xy_max: float = 0.10
    jump_yaw_max: float = 0.10
    jump_window_s: float = 1.0
    anchor_xy_base: float = 0.15
    anchor_xy_per_m: float = 0.03
    anchor_yaw_base: float = 0.10
    anchor_yaw_per_rad: float = 0.03
    ambiguity_radius: float = 1.0
    ambiguity_step: float = 0.1
    ambiguity_yaw_range: float = 0.5
    ambiguity_yaw_step: float = 0.05
    ambiguity_sep: float = 0.5
    ambiguity_margin: float = 0.05
    degenerate_budget_m: float = 2.0
    pose_max_age_moving_s: float = 3.0
    tf_max_age_s: float = 1.0
    scan_max_age_s: float = 0.5
    stable_s: float = 5.0


def wrap(a):
    return (a + math.pi) % (2 * math.pi) - math.pi


# ------------------------------------------------------------------ small measurements
def pose_sigmas(cov36):
    """sigma_xy (sqrt of the larger xy eigenvalue) and sigma_yaw from a row-major 6x6 covariance."""
    c = np.asarray(cov36, float).reshape(6, 6)
    ev = np.linalg.eigvalsh(c[:2, :2])
    return math.sqrt(max(ev[-1], 0.0)), math.sqrt(max(c[5, 5], 0.0))


def cloud_stats(xy, w, sep):
    """(weighted spread, weight outside `sep` of the heaviest particle). Weights need not be normalized."""
    xy, w = np.asarray(xy, float).reshape(-1, 2), np.asarray(w, float)
    if len(xy) == 0 or w.sum() <= 0:
        return float('inf'), 1.0
    w = w / w.sum()
    mode = xy[int(np.argmax(w))]
    near = np.hypot(*(xy - mode).T) <= sep
    outside = float(w[~near].sum())
    m = (xy[near] * w[near, None]).sum(0) / max(w[near].sum(), 1e-12)
    d2 = ((xy[near] - m) ** 2).sum(1)
    spread = math.sqrt(float((d2 * w[near]).sum() / max(w[near].sum(), 1e-12)))
    return spread, outside


class OccGrid:
    """Distance (m) to the nearest occupied cell of a Nav2 map; unknown cells are NOT obstacles."""

    def __init__(self, occupied, resolution, origin_xy):
        from scipy.ndimage import distance_transform_edt
        self.res, self.ox, self.oy = float(resolution), float(origin_xy[0]), float(origin_xy[1])
        occ = np.asarray(occupied, bool)
        self.h, self.w = occ.shape
        self.dist = distance_transform_edt(~occ) * self.res if occ.any() else np.full(occ.shape, np.inf)

    @classmethod
    def from_pgm(cls, yaml_path):
        import os

        import cv2
        import yaml
        with open(yaml_path) as f:
            y = yaml.safe_load(f)
        img = cv2.imread(os.path.join(os.path.dirname(yaml_path), y['image']), cv2.IMREAD_GRAYSCALE)
        if img is None:
            raise FileNotFoundError(y['image'])
        p = img / 255.0 if y.get('negate', 0) else (255 - img) / 255.0     # occupancy probability
        img = np.flipud(p)                                                   # row 0 = bottom (y up)
        return cls(img > float(y.get('occupied_thresh', 0.65)), y['resolution'], y['origin'][:2])

    def dist_at(self, pts):
        i = np.floor((pts[:, 1] - self.oy) / self.res).astype(int)
        j = np.floor((pts[:, 0] - self.ox) / self.res).astype(int)
        ok = (i >= 0) & (i < self.h) & (j >= 0) & (j < self.w)
        d = np.full(len(pts), np.inf)
        d[ok] = self.dist[i[ok], j[ok]]
        return d


def scan_endpoints(ranges, angle_min, angle_inc, rmin, rmax):
    """Endpoints in the sensor (base_footprint) frame."""
    r = np.asarray(ranges, float)
    a = angle_min + angle_inc * np.arange(len(r))
    ok = np.isfinite(r) & (r >= rmin) & (r <= rmax)
    return np.column_stack((r[ok] * np.cos(a[ok]), r[ok] * np.sin(a[ok])))


def to_map(pts_base, pose):
    x, y, th = pose
    c, s = math.cos(th), math.sin(th)
    return np.column_stack((x + c * pts_base[:, 0] - s * pts_base[:, 1], y + s * pts_base[:, 0] + c * pts_base[:, 1]))


def soft_score(pts_base, grid, pose, sigma):
    """Mean exp(-d^2 / 2 sigma^2) over endpoints (1 = all on occupied cells); 0 without points."""
    if len(pts_base) == 0:
        return 0.0
    d = grid.dist_at(to_map(pts_base, pose))
    return float(np.mean(np.exp(-np.minimum(d, 10.0) ** 2 / (2 * sigma ** 2))))


def ambiguity(pts_base, grid, pose, cfg: TrustConfig):
    """Score landscape around `pose`. Returns dict(nominal, best, competitor_score, competitor_offset, ambiguous).
    A competitor is a pose farther than ambiguity_sep (xy) from `pose` whose score is within ambiguity_margin of
    max(nominal, best)."""
    x0, y0, th0 = pose
    r, st = cfg.ambiguity_radius, cfg.ambiguity_step
    xs = np.arange(-r, r + 1e-9, st)
    ths = np.arange(-cfg.ambiguity_yaw_range, cfg.ambiguity_yaw_range + 1e-9, cfg.ambiguity_yaw_step)
    nominal = soft_score(pts_base, grid, pose, cfg.score_sigma)
    best = (nominal, (0.0, 0.0, 0.0))
    comp = (-1.0, None)
    for dth in ths:
        for dx in xs:
            for dy in xs:
                s = soft_score(pts_base, grid, (x0 + dx, y0 + dy, th0 + dth), cfg.score_sigma)
                if s > best[0]:
                    best = (s, (dx, dy, dth))
                if math.hypot(dx, dy) > cfg.ambiguity_sep and s > comp[0]:
                    comp = (s, (dx, dy, dth))
    top = max(nominal, best[0])
    return dict(nominal=nominal, best=best[0], best_offset=best[1], competitor_score=comp[0],
                competitor_offset=comp[1], ambiguous=bool(comp[1] is not None and comp[0] >= top - cfg.ambiguity_margin))


def compose(a, b):
    """a (+) b for SE(2) tuples (x, y, yaw)."""
    c, s = math.cos(a[2]), math.sin(a[2])
    return (a[0] + c * b[0] - s * b[1], a[1] + s * b[0] + c * b[1], wrap(a[2] + b[2]))


def inverse(a):
    c, s = math.cos(a[2]), math.sin(a[2])
    return (-(c * a[0] + s * a[1]), s * a[0] - c * a[1], wrap(-a[2]))


# ------------------------------------------------------------------ stateful evaluator
@dataclass
class Inputs:
    now: float
    map_odom: tuple = None              # (x, y, yaw) of map->odom
    map_odom_stamp: float = float('-inf')
    odom_base: tuple = None             # (x, y, yaw) of odom->base_footprint (LIO)
    amcl_cov: list = None
    amcl_stamp: float = float('-inf')
    cloud_xy: object = None
    cloud_w: object = None
    scan_pts: object = None             # endpoints in base_footprint
    scan_stamp: float = float('-inf')
    moving: bool = False


class TrustEvaluator:
    def __init__(self, grid: OccGrid, cfg: TrustConfig = None):
        self.grid, self.cfg = grid, cfg or TrustConfig()
        self.baseline = None
        self.scores = []                 # (t, S)
        self.mo_hist = []                # (t, map->odom)
        self.anchor = None               # (map_pose, odom_pose, path_len_at_anchor)
        self.path_len, self._last_odom = 0.0, None
        self.degenerate_since_len = None
        self.clean_since = None
        self.last = dict(trusted=False, reasons=['no_data'], metrics={})

    # -- operator actions
    def set_baseline(self, scores):
        """Median score from a clean standing recording at a confirmed pose (stage F0)."""
        self.baseline = float(np.median(scores))

    def confirm_anchor(self, inp: Inputs):
        pose = compose(inp.map_odom, inp.odom_base)
        self.anchor = (pose, inp.odom_base, self.path_len)
        self.clean_since = None
        return pose

    def arm_check(self, inp: Inputs):
        """Run before enabling motion for a goal (from standing). Returns the ambiguity dict."""
        pose = compose(inp.map_odom, inp.odom_base)
        a = ambiguity(inp.scan_pts, self.grid, pose, self.cfg)
        self.degenerate_since_len = self.path_len if a['ambiguous'] else None
        return a

    # -- one evaluation (call at ~5 Hz)
    def evaluate(self, inp: Inputs):
        c, why, m = self.cfg, [], {}
        if self._last_odom is not None and inp.odom_base is not None:
            self.path_len += math.hypot(inp.odom_base[0] - self._last_odom[0], inp.odom_base[1] - self._last_odom[1])
        if inp.odom_base is not None:
            self._last_odom = inp.odom_base
        # T1
        if inp.map_odom is None or inp.now - inp.map_odom_stamp > c.tf_max_age_s:
            why.append('T1_tf_stale')
        if inp.amcl_cov is None or (inp.moving and inp.now - inp.amcl_stamp > c.pose_max_age_moving_s):
            why.append('T1_amcl_pose_stale')
        if inp.scan_pts is None or inp.now - inp.scan_stamp > c.scan_max_age_s:
            why.append('T1_scan_stale')
        # T2
        if inp.amcl_cov is not None:
            sxy, syaw = pose_sigmas(inp.amcl_cov)
            m.update(sigma_xy=sxy, sigma_yaw=syaw)
            if not (sxy <= c.sigma_xy_max and syaw <= c.sigma_yaw_max):
                why.append('T2_covariance')
        # T3
        if inp.cloud_xy is not None:
            spread, outside = cloud_stats(inp.cloud_xy, inp.cloud_w, c.second_mode_sep)
            m.update(cloud_std=spread, second_mode_weight=outside)
            if not (spread <= c.cloud_std_max and outside <= c.second_mode_weight_max):
                why.append('T3_particles')
        else:
            why.append('T3_no_particles')
        # T4
        if inp.map_odom is not None and inp.odom_base is not None and inp.scan_pts is not None and len(inp.scan_pts):
            pose = compose(inp.map_odom, inp.odom_base)
            s = soft_score(inp.scan_pts, self.grid, pose, c.score_sigma)
            m['scan_score'] = s
            self.scores = [(t, v) for t, v in self.scores if inp.now - t <= 5.0] + [(inp.now, s)]
            floor = max(c.hit_min_abs, c.hit_baseline_frac * self.baseline) if self.baseline else c.hit_min_abs
            m['scan_floor'] = floor
            if s < floor:
                why.append('T4_scan_score')
            recent = [v for _, v in self.scores]
            if len(recent) >= 5 and np.median(recent) - s > c.hit_drop_max:
                why.append('T4_scan_drop')
        # T5
        if inp.map_odom is not None:
            self.mo_hist = [(t, p) for t, p in self.mo_hist if inp.now - t <= c.jump_window_s] + [(inp.now, inp.map_odom)]
            p0 = self.mo_hist[0][1]
            jx = max(math.hypot(p[0] - p0[0], p[1] - p0[1]) for _, p in self.mo_hist)
            jy = max(abs(wrap(p[2] - p0[2])) for _, p in self.mo_hist)
            m.update(jump_xy=jx, jump_yaw=jy)
            if jx > c.jump_xy_max or jy > c.jump_yaw_max:
                why.append('T5_map_odom_jump')
        # T6
        if self.anchor is None:
            why.append('T6_no_anchor')
        elif inp.map_odom is not None and inp.odom_base is not None:
            a_map, a_odom, a_len = self.anchor
            predicted = compose(a_map, compose(inverse(a_odom), inp.odom_base))
            now_pose = compose(inp.map_odom, inp.odom_base)
            dist = self.path_len - a_len
            ex = math.hypot(now_pose[0] - predicted[0], now_pose[1] - predicted[1])
            ey = abs(wrap(now_pose[2] - predicted[2]))
            lim_x = c.anchor_xy_base + c.anchor_xy_per_m * dist
            lim_y = c.anchor_yaw_base + c.anchor_yaw_per_rad * dist
            m.update(anchor_err_xy=ex, anchor_err_yaw=ey, anchor_limit_xy=lim_x, path_since_anchor=dist)
            if ex > lim_x or ey > lim_y:
                why.append('T6_anchor_disagreement')
        # degenerate budget
        if self.degenerate_since_len is not None:
            used = self.path_len - self.degenerate_since_len
            m['degenerate_used_m'] = used
            if used > c.degenerate_budget_m:
                why.append('T7_degenerate_budget')
        # hysteresis: trust returns only after stable_s of clean evaluations
        if why:
            self.clean_since = None
            trusted = False
        else:
            if self.clean_since is None:
                self.clean_since = inp.now
            trusted = (inp.now - self.clean_since) >= c.stable_s or self.last['trusted']
            if not trusted:
                why.append('settling')
        self.last = dict(trusted=trusted, reasons=why, metrics=m)
        return self.last
