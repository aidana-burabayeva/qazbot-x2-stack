# Writes build_manifest.yaml (git SHA of the source checkout, dirty flag, build time). Runs at every build.
# Variables: SRC_DIR, OUT.
execute_process(COMMAND git -C "${SRC_DIR}" rev-parse HEAD OUTPUT_VARIABLE sha
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
  set(sha "unknown")
  set(dirty "unknown")
else()
  execute_process(COMMAND git -C "${SRC_DIR}" status --porcelain --untracked-files=no
                  OUTPUT_VARIABLE st OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(st STREQUAL "")
    set(dirty "false")
  else()
    set(dirty "true")
  endif()
endif()
string(TIMESTAMP now "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${OUT}.tmp" "# generated by qazbot_bringup at build time\nsha: ${sha}\ndirty: ${dirty}\nbuilt_utc: ${now}\nsource: ${SRC_DIR}\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
