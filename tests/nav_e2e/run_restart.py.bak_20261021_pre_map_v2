#!/usr/bin/env python3
"""Real Nav2 1.1.18 on D1 grid + existing MC model. No hardware/SDK endpoint."""
import json,math,os,signal,subprocess,sys,time,re
from pathlib import Path
if os.environ.get('ROS_DOMAIN_ID')!='87':raise RuntimeError('requires domain 87')
import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from nav2_msgs.action import NavigateToPose
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Twist,PoseStamped
from std_msgs.msg import Bool,Float64MultiArray,String
from std_srvs.srv import Trigger
root=Path.home()/'control_backend';nav=root/'ws/src/navigation';ns='qazbot_e2e'
out=root/'tests/integration_results'/(sys.argv[1] if len(sys.argv)>1 else 'nav_restart_candidate')
if out.exists():raise RuntimeError('result directory exists')
out.mkdir();procs=[];logs=[];results=[];smac_libraries=[]
def start(name,args):
    f=(out/(name+'.log')).open('w');logs.append(f)
    p=subprocess.Popen(args,stdout=f,stderr=subprocess.STDOUT,start_new_session=True);procs.append((name,p));return p
rclpy.init();n=Node('integration_harness',namespace=ns)
pose=None;vel=None;cmds=[];coord={}
def odom(m):
    global pose,vel
    p,q=m.pose.pose.position,m.pose.pose.orientation;pose=(p.x,p.y,2*math.atan2(q.z,q.w));vel=(m.twist.twist.linear.x,m.twist.twist.angular.z)
def command(m):cmds.append((time.monotonic(),m.linear.x,m.linear.y,m.angular.z))
def status(m):
    global coord
    coord=json.loads(m.data)
n.create_subscription(Odometry,'odom',odom,10);n.create_subscription(Twist,'cmd_vel_authorized',command,10)
n.create_subscription(String,'goal_coordinator/status',status,10)
reset=n.create_publisher(Float64MultiArray,'sim_reset',1);trust=n.create_publisher(Bool,'fixture_trust',1)
scan_enable=n.create_publisher(Bool,'fixture_scan_enabled',1)
odom_enable=n.create_publisher(Bool,'fixture_odom_enabled',1)
client=ActionClient(n,NavigateToPose,'navigate_to_pose');internal=ActionClient(n,NavigateToPose,'nav2/navigate_to_pose')
stop=n.create_client(Trigger,'goal_coordinator/stop');resume=n.create_client(Trigger,'goal_coordinator/resume')
def wait(pred,seconds=30):
    end=time.monotonic()+seconds
    while not pred():
        if any(p.poll() is not None for _,p in procs):raise RuntimeError('child exited')
        if time.monotonic()>end:raise RuntimeError('observation deadline: '+str(coord))
        rclpy.spin_once(n,timeout_sec=.02)
def spin(s):
    end=time.monotonic()+s
    while time.monotonic()<end:rclpy.spin_once(n,timeout_sec=.02)
def call(c):
    wait(lambda:c.service_is_ready());f=c.call_async(Trigger.Request());wait(f.done);return f.result()
def check(name,ok,detail=None):
    results.append(dict(name=name,ok=bool(ok),detail=detail));print(json.dumps(results[-1]),flush=True)
    if not ok:raise AssertionError(name)
def new_goal(x,y,yaw):
    g=NavigateToPose.Goal();g.pose.header.frame_id='map';g.pose.header.stamp=n.get_clock().now().to_msg()
    g.pose.pose.position.x=float(x);g.pose.pose.position.y=float(y)
    g.pose.pose.orientation.z=math.sin(yaw/2);g.pose.pose.orientation.w=math.cos(yaw/2)
    f=client.send_goal_async(g);wait(f.done);return f.result()
def reset_pose():
    reset.publish(Float64MultiArray(data=[-1.275,-6.375,0.,-1.]));spin(.5)
    wait(lambda:vel and max(abs(v) for v in vel)<.01)
    wait(lambda:not coord.get('busy',True) and coord.get('source_zero',False))
try:
    start('model',['python3',str(root/'tests/nav_e2e/model_fixture.py'),ns,'--ros-args','-r',f'/{ns}/cmd_vel:=/{ns}/cmd_vel_authorized'])
    wait(lambda:pose is not None)
    args=['ros2','launch',str(nav/'nav_full.launch.py'),f'ns:={ns}','robot_radius:=0.454',f'scan_topic:=/{ns}/scan',f'odom_topic:=/{ns}/odom']
    parent=start('nav2',args);wait(lambda:client.server_is_ready() and coord.get('ready',False),60)
    reset_pose();h=new_goal(.425,-6.375,0.);check('goal_A_accepted',h.accepted);old_result=h.get_result_async()
    wait(lambda:vel and vel[0]>.15)
    candidates=[]
    for row in subprocess.check_output(['ps','-eo','pid=,args='],text=True).splitlines():
        if '/lib/nav2_controller/controller_server ' in row and '__ns:=/'+ns+'/nav2' in row:candidates.append(int(row.split()[0]))
    check('single_controller_before_fault',len(candidates)==1,candidates)
    os.kill(candidates[0],signal.SIGINT)
    procs.remove(('nav2',parent))
    wait(lambda:parent.poll() is not None,20);check('coherent_group_stopped',parent.returncode==0)
    wait(lambda:vel and max(abs(v) for v in vel)<.01,5);t=time.monotonic();p0=pose;spin(.8)
    check('no_commands_after_group_exit',not any(abs(v)>1e-9 or abs(w)>1e-9 for a,v,_,w in cmds if a>=t))
    check('model_stopped',math.dist(p0[:2],pose[:2])<.01,dict(before=p0,after=pose))
    old_uuid=[int(x) for x in h.goal_id.uuid]
    coord={};reset.publish(Float64MultiArray(data=[-1.275,-6.375,0.,-1.]));spin(.3)
    start('nav2_restarted',args);wait(lambda:coord.get('ready',False),60)
    spin(.8);check('restart_has_no_cached_goal',not coord.get('busy') and not coord.get('gate'))
    check('restart_does_not_move',vel and max(abs(v) for v in vel)<.01)
    h2=new_goal(-.775,-6.375,0.);check('new_goal_B_after_restart',h2.accepted)
    check('new_goal_UUID',old_uuid!=[int(x) for x in h2.goal_id.uuid]);f=h2.get_result_async();wait(f.done,30)
    check('new_goal_B_succeeds',f.result().status==4)
    check('actual_pose_B',math.hypot(pose[0]+.775,pose[1]+6.375)<.11,pose)

finally:
    for _,p in reversed(procs):
        if p.poll() is None:os.kill(p.pid,signal.SIGINT)
    codes={}
    for name,p in reversed(procs):
        try:codes[name]=p.wait(timeout=15)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid,signal.SIGTERM);codes[name]=p.wait(timeout=5)
    for f in logs:f.close()
    abnormal=re.findall(r'process has died.*exit code (-?\d+)',str().join(p.read_text() for p in (out/'nav2.log',out/'nav2_restarted.log') if p.exists()))
    codes['abnormal_children']=len([x for x in abnormal if int(x)!=0])
    debug_logs=str().join(p.read_text() for p in (out/'nav2.log',out/'nav2_restarted.log') if p.exists())
    codes['debugger_fatal_signals']=len(re.findall(r'received signal SIG(?:ABRT|SEGV|BUS|ILL)',debug_logs))
    (out/'results.json').write_text(json.dumps(dict(checks=results,shutdown=codes,
        smac_libraries=smac_libraries,scope='D1 grid + real Nav2 + ideal localization fixture + existing MC model; no AMCL/SDK qualification'),indent=2))
    n.destroy_node();rclpy.try_shutdown()
    if any(c!=0 for c in codes.values()):raise RuntimeError('unclean shutdown: '+str(codes))
