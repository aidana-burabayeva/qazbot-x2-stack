#!/usr/bin/env bash
# P12 2026-10-28: restart Localization Trust ONLY (same command as start.sh, incl. T5 0.25 m / 0.25 rad operator override).
set -u
EV=/home/agi/control_backend/docs/evidence/nav_20261029_1425
NAV=/home/agi/control_backend/ws/src/navigation
MAP=/home/agi/control_backend/ws/src/maps/first_map_nav2_v3_despeckled/map.yaml
MAP_SHA=6fc67526d5314447d3ffa25d4144310d78b5202a649e87d852735b87c9f320e5
PROF=$EV/dds_nav_two_iface_log.xml
log(){ echo "[$(date +%T.%N)] restart_trust: $*" | tee -a $EV/start_run.txt; }
OLD=$(cat $EV/trust.pid)
ps -o args= -p $OLD | grep -q localization_trust_node.py || { log "ABORT: trust.pid $OLD is not localization_trust"; exit 2; }
N=$(pgrep -fc '^python3 localization_trust_node.py'); [ "$N" = 1 ] || { log "ABORT: $N trust instances"; exit 3; }
log "SIGINT trust $OLD"; kill -INT $OLD
for i in $(seq 1 40); do kill -0 $OLD 2>/dev/null || break; sleep 0.5; done
kill -0 $OLD 2>/dev/null && { log "INT timeout -> TERM"; kill -TERM $OLD; sleep 3; }
kill -0 $OLD 2>/dev/null && { log "ABORT: $OLD still alive"; exit 4; }
mv $EV/trust.log $EV/trust_pre_p12_$(date +%H%M%S).log
cd $NAV
set +u; source ./env.sh >/dev/null 2>&1; set +e
export FASTRTPS_DEFAULT_PROFILES_FILE=$PROF ROS_DOMAIN_ID=0 ROS_LOCALHOST_ONLY=0
setsid nohup bash -c "exec python3 localization_trust_node.py --ros-args -p map_yaml:=$MAP -p expected_map_sha256:=$MAP_SHA -p admission_policy:=go2 -p odom_source:=native_imu -p odom_topic:=/qazbot_native/odom -p jump_xy_max:=0.25 -p jump_yaw_max:=0.25" > $EV/trust.log 2>&1 < /dev/null &
TSID=$!; echo $TSID > $EV/trust.pid
for i in $(seq 1 80); do grep -q 'localization_trust started' $EV/trust.log && break; sleep 0.5; done
log "trust: pid $TSID started=$(grep -c 'localization_trust started' $EV/trust.log) env=$(tr '\0' '\n' < /proc/$TSID/environ | grep -E '^(FASTRTPS_DEFAULT_PROFILES_FILE|ROS_DOMAIN_ID|ROS_LOCALHOST_ONLY)=' | tr '\n' ' ')"
